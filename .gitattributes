# Normalize text sources to LF regardless of checkout platform, so a
# Windows checkout never introduces CRLF into files Vercel's Linux build
# environment (or a contributor on Linux/macOS) will read.
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.astro text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ino text eol=lf
*.h text eol=lf
*.sql text eol=lf

# Windows-only tooling keeps CRLF.
*.ps1 text eol=crlf

# Binary assets: never touched by line-ending normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.ico binary
*.pdf binary
*.woff2 binary
