# Scripts that run on the Orange Pi (Linux) must never pick up CRLF from a
# Windows checkout — a CRLF line ending in a shebang script fails outright
# on Linux with "$'\r': command not found".
*.sh text eol=lf
scripts/opi_ap_on.sh text eol=lf
scripts/opi_ap_off.sh text eol=lf

# Python and web sources: normalize to LF regardless of checkout platform.
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only tooling keeps CRLF.
*.ps1 text eol=crlf

# Typst sources: no enforced ending (test PDFs against whatever line
# endings the file already has; forcing a switch here would touch every
# journal for no functional reason before Phase 1 even starts).
*.typ -text

# Binary assets: never touched by line-ending normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.pdf binary
*.xlsm binary
*.woff2 binary
