# Dependencies
node_modules/

# Build output — generated, never committed. CI rebuilds and diffs instead
# of trusting a committed artifact (see games/REBUILD.md gotcha 2, where a
# stale committed build shipped silently).
dist/
web/.astro/
games/index.html
games/public/index.html
modul4/public/index.html

# Generated from Module - IRIS IoT/data_asisten.typ by scripts/seed_asisten.py.
# Regenerated in CI on every run so the site can never silently drift from
# the (finalized, never-hand-edited) handbook.
web/src/data/asisten.json

# Environment / secrets
.env
.env.*
!.env.example
.vercel/

# Firebase service-account keys, however someone happens to name the download
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
*-adminsdk-*.json

# Debug output from scripts/check_secrets.py
fresh-scan.json

# Runtime state that belongs to a running lab session, not to history
modul4/jadwal.json
modul4/jadwal.json.tmp
modul4/uploads/

# Python
__pycache__/
*.pyc

# Persistent arduino-cli build cache used by scripts/check_sketches.py so the
# ESP32 core compiles once instead of once per sketch
scripts/.arduino-build-cache/

# Editor / OS noise
.DS_Store
Thumbs.db

# Machine-local tool cache: absolute Windows paths and session ids, useless to
# anyone else and guaranteed to conflict
.impeccable/hook.cache.json

# Hand-built Pi bundle, derived from agent/ + modul4/ + kunci_jawaban/ +
# scripts/. Regenerate it when those change rather than committing a copy that
# silently goes stale (ORANGE_PI_SERVER_SETUP.md section 5 consumes it)
iris-pi-server-setup.zip
