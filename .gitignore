# Dependencies
node_modules/

# Build output — generated, never committed. CI rebuilds and diffs instead
# of trusting a committed artifact (see apps/games/REBUILD.md gotcha 2,
# where a stale committed build shipped silently).
dist/
apps/web/.astro/
apps/games/index.html
apps/games/public/index.html

# Generated from the vendored handbook copy by apps/web/scripts/seed_asisten.py.
# Regenerated in CI on every run so the site can never silently drift.
apps/web/src/data/asisten.json

# Environment / secrets
.env
.env.*
!.env.example
.vercel/

# Firebase service-account keys, however someone happens to name the download
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
*-adminsdk-*.json

# Debug output from scripts/check_secrets.py
fresh-scan.json

# Python
__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
Thumbs.db
