# Dependencies
node_modules/

# Build output — generated, never committed. CI rebuilds and diffs instead
# of trusting a committed artifact (see games/REBUILD.md gotcha 2, where a
# stale committed build shipped silently).
dist/
web/.astro/
games/index.html
games/public/index.html
hunt/public/index.html

# Generated from Module - IRIS IoT/data_asisten.typ by scripts/seed_asisten.py.
# Regenerated in CI on every run so the site can never silently drift from
# the (finalized, never-hand-edited) handbook.
web/src/data/asisten.json

# Environment / secrets
.env
.env.*
!.env.example
.vercel/

# Firebase service-account keys, however someone happens to name the download
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
*-adminsdk-*.json

# Runtime state that belongs to a running lab session, not to history
hunt/jadwal.json
hunt/jadwal.json.tmp
hunt/uploads/

# Python
__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
Thumbs.db
