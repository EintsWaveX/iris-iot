[Unit]
Description=IRIS IoT practicum site - Orange Pi agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iris-agent
Group=iris-agent
Environment=IRIS_AGENT_CONFIG=/etc/iris-agent/config.json
Environment=IRIS_AGENT_SPOOL=/var/lib/iris-agent/spool.json
ExecStart=/usr/bin/python3 /opt/iris-agent/agent.py run
Restart=on-failure
RestartSec=15

# NoNewPrivileges is left at its default (false) deliberately: it stays
# false because commands.py's whitelisted actions run via sudo, and
# NoNewPrivileges=true blocks setuid/sudo at the kernel level for this
# process AND every child it execs -- setting it true here would silently
# break every "layanan.*"/"ap.*"/"jam.selaraskan" command rather than
# harden anything. The real boundary on what this process can do is
# install.sh's sudoers file, which names the exact binaries, not this
# setting.
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/iris-agent

[Install]
WantedBy=multi-user.target
