---
/**
 * IRIS IoT practicum site — the one page shell.
 *
 * Every page imports this and nothing else for its <head>. tokens.css and
 * base.css are the single source of the design system (tokens.css is a
 * byte-for-byte copy of hunt/src/style/tokens.css — see that file's header
 * for why it is the canonical one, not games/'s near-duplicate).
 */
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description?: string;
  lang?: "id" | "en";
}

const { title, description = "", lang = "id" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
