---
/**
 * A titled block on a hairline, not a floating glass box — the editorial
 * language carried over from hunt/'s .section pattern, scoped to a single
 * card rather than a whole page section.
 */
interface Props {
  title?: string;
  eyebrow?: string;
  class?: string;
  id?: string;
  hidden?: boolean;
  [attr: string]: unknown;
}

const { title, eyebrow, class: className, id, hidden, ...rest } = Astro.props;
---

<article id={id} hidden={hidden} class:list={["card", className]} {...rest}>
  {(title || eyebrow) && (
    <header class="card__head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {title && <h3 class="card__title">{title}</h3>}
    </header>
  )}
  <div class="card__body">
    <slot />
  </div>
</article>

<style>
  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .card__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .card__title {
    font-size: var(--fs-display-sm);
  }

  .card__body {
    color: var(--text-muted);
  }
</style>
