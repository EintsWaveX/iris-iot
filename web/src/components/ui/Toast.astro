---
/**
 * A toast host. Include exactly once per page (in Base.astro or a page
 * layout); anything on the page can then call window.Toast.show(message,
 * tone) to raise a notice, the pattern hunt/src/ui-notify.js already
 * established for things like "session rolled over, you were signed out".
 */
---

<div class="toast-host" id="toast-host" aria-live="polite" aria-atomic="true"></div>

<style is:global>
  .toast-host {
    bottom: max(var(--space-5), env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    left: 50%;
    pointer-events: none;
    position: fixed;
    transform: translateX(-50%);
    width: min(28rem, calc(100vw - var(--space-8)));
    z-index: 200;
  }

  .toast {
    background: var(--bg-elevated);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-panel);
    color: var(--text);
    font-size: var(--fs-small);
    padding: var(--space-3) var(--space-4);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur-mid) var(--ease-out-expo),
      transform var(--dur-mid) var(--ease-out-expo);
  }

  .toast[data-shown="yes"] {
    opacity: 1;
    transform: translateY(0);
  }

  .toast[data-tone="warn"] {
    border-color: color-mix(in srgb, var(--warn) 55%, transparent);
  }
  .toast[data-tone="danger"] {
    border-color: color-mix(in srgb, var(--danger) 55%, transparent);
  }
  .toast[data-tone="ok"] {
    border-color: color-mix(in srgb, var(--ok) 55%, transparent);
  }
</style>

<script>
  (function () {
    if (window.Toast) return;

    function show(message: string, tone: "info" | "ok" | "warn" | "danger" = "info") {
      const host = document.getElementById("toast-host");
      if (!host) return;

      const node = document.createElement("p");
      node.className = "toast";
      node.setAttribute("data-tone", tone);
      node.textContent = message;
      host.appendChild(node);

      // Two rAFs: the element needs one committed frame at its initial
      // (hidden) state before the "shown" class can transition from it.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          node.setAttribute("data-shown", "yes");
        }),
      );

      window.setTimeout(() => {
        node.removeAttribute("data-shown");
        window.setTimeout(() => node.remove(), 400);
      }, 4000);
    }

    window.Toast = { show };
  })();
</script>
