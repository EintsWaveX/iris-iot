---
import { tri } from "../lib/labels";
/**
 * /account and /en/account (Phase 8): profile, language, and for
 * assistants the password change, their week and their own feedback.
 */
import Base from "../layouts/Base.astro";
import AccountPage from "../components/account/AccountPage";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base
  noindex
  title={`${tri(lang, "Akun", "Account", "账号")} · IRIS IoT`}
  lang={lang}
  cosmosScene="kerja"
>
  <main id="main" class="page-regular page-main">
    <AccountPage client:load lang={lang} />
  </main>
</Base>
