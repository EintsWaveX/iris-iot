---
/**
 * /recruitment, /en/recruitment and /zh/recruitment (2026-10-23): the candidate's page.
 * Open Recruitment's own navbar replaces the practicum's (Base shell).
 */
import Base from "../layouts/Base.astro";
import CandidatePage from "../components/recruitment/candidate/CandidatePage";
import { tri } from "../lib/labels";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base
  noindex
  title={`${tri(lang, "Open Recruitment Asisten", "Asisten Open Recruitment", "助教招募")} · IRIS IoT`}
  description={tri(
    lang,
    "Open Recruitment Asisten Laboratorium IRIS, Telkom University. Lihat jadwal, berkas, dan hasil seleksimu di sini.",
    "Assistant Open Recruitment of the IRIS Laboratory, Telkom University. See your schedule, documents and results here.",
    "Telkom University IRIS 实验室助教招募。在这里查看你的日程、材料和结果。",
  )}
  lang={lang}
  cosmosScene="kerja"
  shell="rekrutmen"
>
  <main id="main" class="page-wide page-main">
    <CandidatePage client:load lang={lang} />
  </main>
</Base>
