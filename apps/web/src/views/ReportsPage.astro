---
import { tri } from "../lib/labels";
/**
 * /reports and /en/reports (Phase 8): session history, module summary, lab
 * feedback and audit, plus each session's own report (?sesi=N). One island,
 * reports/Reports.tsx, assistants only.
 */
import Base from "../layouts/Base.astro";
import Reports from "../components/reports/ReportsApp";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base
  title={`${tri(lang, "Laporan", "Reports", "报告")} · IRIS IoT`}
  lang={lang}
  cosmosScene="teknis"
>
  <main id="main" class="page-wide page-main">
    <Reports client:load lang={lang} />
  </main>
</Base>
