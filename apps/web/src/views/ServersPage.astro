---
/** /servers, /en/servers and /zh/servers: the Server page island (Phase 9 Stage 5). */
import Base from "../layouts/Base.astro";
import ServerCenter from "../components/server/ServerCenter";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const title = lang === "en" ? "Servers" : lang === "zh" ? "服务器" : "Server";
---

<Base title={`${title} · IRIS IoT`} lang={lang} cosmosScene="teknis">
  <main id="main" class="page-wide page-main">
    <ServerCenter client:load lang={lang} />
  </main>
</Base>
