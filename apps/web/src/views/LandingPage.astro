---
/**
 * /, /en/ and /zh/: Home, concept A "The lab right now" (Phase 9 Stage 7).
 * HomePage.tsx holds the hero by role, the live lab card, how a session
 * runs and the module lanes. The module cards live on /modules only.
 * Arriving at /?login=1 (where /masuk and /login redirect) opens the login
 * dialog; LoginDialog.tsx handles that itself.
 */
import Base from "../layouts/Base.astro";
import HomePage from "../components/home/HomePage";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const description =
  lang === "en"
    ? "The IRIS IoT practicum. Four modules, one board."
    : lang === "zh"
      ? "IRIS 物联网实验。四个模块，一块板子。"
      : "Praktikum IoT IRIS. Empat modul, satu papan.";
---

<Base title="IRIS IoT" description={description} cosmosScene="beranda" lang={lang}>
  <main id="main" class="page-wide page-main">
    <HomePage client:load lang={lang} />
  </main>
</Base>
