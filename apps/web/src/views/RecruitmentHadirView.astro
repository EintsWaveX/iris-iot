---
/**
 * /recruitment/hadir and its en and zh twins (2026-10-24): where a phone lands after scanning the QR.
 */
import Base from "../layouts/Base.astro";
import Hadir from "../components/recruitment/qr/Hadir";
import { tri } from "../lib/labels";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base
  noindex
  title={`${tri(lang, "Catat Kehadiran", "Mark Attendance", "记录出席")} · IRIS IoT`}
  description={tri(
    lang,
    "Catat kehadiranmu di acara Open Recruitment Asisten IRIS dengan kode atau QR.",
    "Mark your attendance at an IRIS assistant recruitment event with a code or QR.",
    "用代码或二维码记录你在 IRIS 助教招募活动的出席。",
  )}
  lang={lang}
  cosmosScene="kerja"
  shell="rekrutmen"
>
  <main id="main" class="page-wide page-main">
    <Hadir client:load lang={lang} />
  </main>
</Base>
