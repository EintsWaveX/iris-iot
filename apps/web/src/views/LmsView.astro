---
/**
 * /lms, /en/lms and /zh/lms (Phase 15): the LMS menu (Beta), one island
 * (lms/LmsPage.tsx).
 */
import Base from "../layouts/Base.astro";
import LmsPage from "../components/lms/LmsPage";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base noindex title="LMS · IRIS IoT" lang={lang} cosmosScene="kerja">
  <main id="main" class="page-wide page-main">
    <LmsPage client:load lang={lang} />
  </main>
</Base>
