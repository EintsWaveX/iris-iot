---
/**
 * The living style guide. Every primitive, every state, on one page.
 *
 * This exists for two reasons: it is the fastest way to catch a visual
 * regression (one page to check instead of twelve, per the Phase 1 plan),
 * and it is where a new primitive gets proven in every state — default,
 * hover, focus, disabled, loading, error — before it is used anywhere real.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/ui/Nav.astro";
import Button from "../components/ui/Button.astro";
import Field from "../components/ui/Field.astro";
import Select from "../components/ui/Select.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Table from "../components/ui/Table.astro";
import Tabs from "../components/ui/Tabs";
import EmptyState from "../components/ui/EmptyState.astro";
import Modal from "../components/ui/Modal.astro";
import Toast from "../components/ui/Toast";

const links = [
  { href: "/", label: "Beranda" },
  { href: "/ui", label: "UI" },
];
---

<Base title="Panduan gaya · IRIS IoT" description="Living style guide" cosmosScene="kerja">
  <Nav links={links} current="/ui" />
  <Toast client:load />

  <main class="measure">
    <section class="section">
      <div class="section__head">
        <h1 class="section__title">Panduan gaya</h1>
        <p class="eyebrow">Satu halaman, dua belas primitif</p>
      </div>
      <p>
        Setiap tombol, field, kartu, dan modal di seluruh situs berasal dari berkas-berkas yang
        dirender di halaman ini. Tidak ada gaya sekali-pakai di tempat lain. Kalau sesuatu di sini
        terlihat salah, perbaikannya berlaku di mana-mana sekaligus.
      </p>
    </section>

    <section class="section">
      <h2 class="section__title">Breakpoints</h2>
      <p class="eyebrow">
        sm sampai 640 &middot; md 641 sampai 1024 &middot; lg 1025 sampai 1440 &middot; xl dari 1441
      </p>
      <div class="bp-ruler">
        <span class="bp-ruler__tier" data-tier="sm">
          sm
        </span>
        <span class="bp-ruler__tier" data-tier="md">
          md
        </span>
        <span class="bp-ruler__tier" data-tier="lg">
          lg
        </span>
        <span class="bp-ruler__tier" data-tier="xl">
          xl
        </span>
        <span class="bp-ruler__width" id="bp-width"></span>
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Button</h2>
      <div class="row">
        <Button kind="ghost">Ghost</Button>
        <Button kind="primary">Primary</Button>
        <Button kind="danger">Danger</Button>
        <Button kind="ghost" disabled>
          Disabled
        </Button>
        <Button kind="primary" loading>
          Loading
        </Button>
        <Button kind="ghost" href="/ui">
          Sebagai tautan
        </Button>
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Field</h2>
      <div class="grid2">
        <Field
          id="nim-default"
          label="NIM"
          placeholder="2311102001"
          hint="4 sampai 20 karakter, huruf dan angka."
        />
        <Field
          id="nim-error"
          label="NIM"
          value="99"
          error="NIM ini tidak terdaftar di sesi yang sedang berjalan."
        />
        <Field id="pw" label="Kata sandi" type="password" placeholder="••••••••••••••••" />
        <Field id="time" label="Jam mulai" type="time" value="06:30" />
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Select</h2>
      <div class="grid2">
        <Select
          id="modul"
          label="Modul"
          options={[
            { value: "1", label: "Modul 1 · BLE" },
            { value: "2", label: "Modul 2 · WebSocket" },
            { value: "3", label: "Modul 3 · MQTT" },
            { value: "4", label: "Modul 4 · LoRa" },
          ]}
          value="2"
        />
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Badge</h2>
      <div class="row">
        <Badge tone="neutral">Netral</Badge>
        <Badge tone="accent">Accent</Badge>
        <Badge tone="ok">Aktif</Badge>
        <Badge tone="warn">Peringatan</Badge>
        <Badge tone="danger">Ditolak</Badge>
        <Badge tone="gold">Juara</Badge>
        <Badge group={1}>Kelompok 1</Badge>
        <Badge group={3}>Kelompok 3</Badge>
        <Badge group={5}>Kelompok 5</Badge>
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Card</h2>
      <div class="grid2">
        <Card eyebrow="Modul 2 · WebSocket" title="Server Orange Pi">
          <p>lab1.iris-iot &middot; 192.168.1.9 &middot; online</p>
        </Card>
        <Card title="Tanpa eyebrow">
          <p>Isi kartu apa pun bisa masuk di sini.</p>
        </Card>
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Table</h2>
      <Table
        caption="Contoh regu"
        columns={[
          { key: "nomor", label: "No" },
          { key: "nama", label: "Nama regu" },
          { key: "anggota", label: "Anggota", align: "right" },
        ]}
        rows={[
          { nomor: 1, nama: "Kelompok Cakra", anggota: 4 },
          { nomor: 2, nama: "Kelompok Bayu", anggota: 3 },
          { nomor: 3, nama: "Kelompok Gana", anggota: 4 },
        ]}
      />
    </section>

    <section class="section">
      <h2 class="section__title">Tabs</h2>
      <Tabs
        client:load
        id="demo-tabs"
        tabs={[
          { id: "panel-a", label: "Sesi 1" },
          { id: "panel-b", label: "Sesi 2" },
        ]}
      />
      <div id="panel-a" role="tabpanel" class="tabpanel">
        Isi sesi 1.
      </div>
      <div id="panel-b" role="tabpanel" class="tabpanel" hidden>
        Isi sesi 2.
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Empty state</h2>
      <EmptyState
        title="Belum ada server terdaftar"
        hint="Tempelkan token pendaftaran pada Orange Pi untuk memunculkannya di sini."
      >
        <Button kind="primary">Daftarkan server</Button>
      </EmptyState>
    </section>

    <section class="section">
      <h2 class="section__title">Modal</h2>
      <Button kind="ghost" data-modal-open="demo-modal">
        Buka modal
      </Button>
      <Modal id="demo-modal" title="Hapus jadwal?" lede="Tindakan ini tidak bisa dibatalkan.">
        <Fragment slot="body">
          <p>Seluruh sesi hari ini akan dikosongkan.</p>
        </Fragment>
        <Fragment slot="actions">
          <Button kind="ghost" data-modal-close>
            Batal
          </Button>
          <Button kind="danger" data-modal-close>
            Hapus
          </Button>
        </Fragment>
      </Modal>
    </section>

    <section class="section">
      <h2 class="section__title">Toast</h2>
      <Button kind="ghost" id="toast-demo-info">
        Info
      </Button>
      <Button kind="ghost" id="toast-demo-warn">
        Peringatan
      </Button>
      <Button kind="ghost" id="toast-demo-danger">
        Galat
      </Button>
    </section>
  </main>

  <script>
    import { sekaliPerHalaman } from "../scripts/per-halaman";
    document.getElementById("toast-demo-info")?.addEventListener("click", () => {
      window.Toast?.show("Sesi berhasil disimpan.", "ok");
    });
    document.getElementById("toast-demo-warn")?.addEventListener("click", () => {
      window.Toast?.show("Sesi berakhir dalam 15 menit.", "warn");
    });
    document.getElementById("toast-demo-danger")?.addEventListener("click", () => {
      window.Toast?.show("NIM ini tidak terdaftar.", "danger");
    });

    // Live breakpoint indicator: which of the four tiers the current
    // viewport falls into, and its exact width, read on load and on
    // every resize -- the same four figures docs/design-system.md's
    // layout section and every page's own @media rules are written
    // against, made checkable without opening devtools.
    function updateBreakpointIndicator() {
      const width = window.innerWidth;
      const tier = width <= 640 ? "sm" : width <= 1024 ? "md" : width <= 1440 ? "lg" : "xl";
      document.querySelectorAll<HTMLElement>(".bp-ruler__tier").forEach((el) => {
        el.dataset.active = el.dataset.tier === tier ? "yes" : "no";
      });
      const widthEl = document.getElementById("bp-width");
      if (widthEl) widthEl.textContent = `${width}px`;
    }

    updateBreakpointIndicator();
    window.addEventListener("resize", updateBreakpointIndicator, { passive: true });
    document.addEventListener("astro:page-load", updateBreakpointIndicator);

    // The one entrance per page. No stagger here: unlike the other three
    // pages, this one has no repeating list -- it is a sequence of
    // unrelated demo sections, and staggering those would be a contrived
    // effect rather than an honest one.
    function playEntrance() {
      window.Motion?.enter(".section:first-of-type > *");
    }
    sekaliPerHalaman("UiAnimasi", playEntrance);
  </script>
</Base>

<style>
  .row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .grid2 {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .tabpanel {
    color: var(--text-muted);
    padding: var(--space-5) 0;
  }

  .bp-ruler {
    align-items: center;
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .bp-ruler__tier {
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    padding: var(--space-1) var(--space-4);
    text-transform: uppercase;
  }

  .bp-ruler__tier[data-active="yes"] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }

  .bp-ruler__width {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    margin-left: var(--space-3);
  }
</style>
