---
/**
 * The praktikan dashboard. Rendered from /api/auth/me the same "static
 * shell, client fills in from the API" way every role-branched page here
 * is (output: 'static' has no request-time cookie access) -- but as of
 * Stage 10, this page is praktikan-only: an assistant landing here bounces
 * straight to /session, the real console, rather than sharing this page
 * with a second view branch. LoginDialog.tsx navigates every successful
 * praktikan login to /dashboard regardless of anything page-specific,
 * which is why that redirect happens here rather than by pointing the
 * dialog at two different destinations.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/ui/Nav.astro";
import { navUtama } from "../lib/nav-links";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import Chip from "../components/ui/Chip.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Toast from "../components/ui/Toast";
import PresentationCard from "../components/PresentationCard";

const links = navUtama();

const MODULES = [
  { modul: 1, nama: "Bluetooth Low Energy" },
  { modul: 2, nama: "WebSocket" },
  { modul: 3, nama: "MQTT" },
  { modul: 4, nama: "LoRa" },
] as const;
---

<Base title="Dasbor · IRIS IoT" cosmosScene="kerja">
  <Nav links={links} current="/dashboard" />
  <Toast client:load />

  <!--
    P7.4 rebuild, following the signed-off P7.2 mockup: a compact single
    -row banner (status badge, module, a slim progress bar, the primary
    CTA) replacing the old full-height identity block, plus a 12-ish-
    column bento below it (presentation as the main tile, group/module-
    list/LoRa as the sidebar) replacing the old single stacked column of
    cards. The redundant "Selamat datang" heading from the old layout is
    dropped -- the banner and the page's own title already say what's
    going on without it.

    Asisten-only for now: /api/session/current, the only endpoint that
    knows the running module and its timing, is deliberately
    assistant-only (its response also carries the full roster, including
    every group's members). Extending this banner to praktikan needs a
    narrower endpoint -- module and timing only, no roster -- which is a
    real, flagged follow-up, not an oversight.
  -->
  <div id="session-banner-host" class="banner" hidden>
    <div class="banner__inner page-wide">
      <div class="banner__running" id="session-banner" hidden>
        <div class="banner__identity">
          <Badge id="banner-status-badge" tone="accent">
            Sesi berjalan
          </Badge>
          <p class="banner__module">
            <span class="mono banner__module-eyebrow">
              Modul <span id="banner-modul-nomor"></span>
            </span>
            <span class="banner__module-nama" id="banner-modul-nama"></span>
          </p>
        </div>
        <div class="banner__progress">
          <span class="mono banner__progress-text" id="banner-durasi"></span>
          <div class="banner__bar">
            <span id="banner-bar-fill"></span>
          </div>
          <a href="/modules/1" id="banner-buka-modul" class="btn btn--primary btn--sm">
            Buka Modul <span id="banner-buka-modul-nomor"></span>
          </a>
        </div>
      </div>
      <div class="banner__kosong" id="session-banner-kosong" hidden>
        <Badge tone="neutral">Tidak ada sesi</Badge>
        <p class="banner__kosong-teks">Belum ada sesi yang berjalan hari ini.</p>
      </div>
    </div>
  </div>

  <main class="page-regular">
    <div id="loading">
      <EmptyState title="Memuat…" />
    </div>

    <div id="view-praktikan" class="bento" hidden>
      <Card title="Presentasi" class="bento__main">
        <PresentationCard client:load />
      </Card>

      <div class="bento__side">
        <Card id="group-card" class="group-card">
          <Badge id="praktikan-badge">Kelompok</Badge>
          <p id="praktikan-nama" class="group-card__nama"></p>
          <Button kind="ghost" size="sm" id="link-kelompok-live" class="group-card__link">
            Lihat ladder kelompok
          </Button>
        </Card>

        <Card title="Modul praktikum" class="module-list-card">
          <div class="module-list" id="modules-grid">
            {MODULES.map(({ modul, nama }) => (
              <a class="mini-mod" href={`/modules/${modul}`} data-mini-mod={modul}>
                <span class="mini-mod__dot" />
                <span class="mini-mod__nama">
                  {modul} &middot; {nama}
                </span>
                <Chip class="mini-mod__chip" hidden />
              </a>
            ))}
          </div>
        </Card>

        <Card eyebrow="Modul 4" title="Perburuan LoRa" class="modul4-card" id="modul4-card" hidden>
          <p>
            Papan skor perburuan berjalan langsung di Orange Pi lab, di jaringan{" "}
            <strong>IRIS-IOT</strong>, bukan lewat internet. Sambungkan HP ke hotspot itu dahulu,
            baru buka tautan ini.
          </p>
          <Button kind="primary" size="sm" id="btn-buka-iot">
            Buka papan skor
          </Button>
        </Card>
      </div>
    </div>
  </main>

  <script>
    import { navigate } from "astro:transitions/client";
    import { startPolling } from "../scripts/polling";
    import { watchIdentity } from "../scripts/identity-watch";
    import { getAksesState, terkunciUntuk } from "../scripts/modul-akses";
    import { SESI_CAP_MENIT } from "../lib/jadwal";

    // A stopgap, not a real content model: the schema's sesi.modul is a
    // bare integer with no metadata table behind it (there is nowhere in
    // the database to hang a module's display name yet), and building
    // that table is Phase 5's own Stage 4, not this one. Four modules
    // that never change order justify a literal map for now.
    const MODULE_NAMES: Record<number, string> = {
      1: "Bluetooth Low Energy",
      2: "WebSocket",
      3: "MQTT",
      4: "LoRa",
    };

    function formatProgress(
      mulai: string,
      mulaiPadaIso: string | null,
    ): { label: string; persen: number } {
      const mulaiMs = mulaiPadaIso ? new Date(mulaiPadaIso).getTime() : NaN;
      if (Number.isNaN(mulaiMs)) return { label: `Mulai ${mulai}`, persen: 0 };
      const berjalanMenit = Math.max(0, Math.round((Date.now() - mulaiMs) / 60000));
      const sisaMenit = Math.max(0, SESI_CAP_MENIT - berjalanMenit);
      return {
        label: `Mulai ${mulai} · ${berjalanMenit} menit · sisa ${sisaMenit} menit`,
        persen: Math.min(100, Math.round((berjalanMenit / SESI_CAP_MENIT) * 100)),
      };
    }

    // Module list sidebar card: locked state is fetched once (it barely
    // ever changes mid-session) and set here; which module is the active
    // one changes every poll tick, so it's a separate function called from
    // renderBanner() below rather than folded into this one.
    async function renderModuleLocks() {
      const state = await getAksesState();
      for (const modul of [1, 2, 3, 4]) {
        const row = document.querySelector<HTMLAnchorElement>(`[data-mini-mod="${modul}"]`);
        if (!row) continue;
        const locked = terkunciUntuk(state, modul);
        row.classList.toggle("is-locked", locked);
        const chip = row.querySelector<HTMLElement>(".mini-mod__chip");
        if (chip && locked) {
          chip.textContent = "Terkunci";
          chip.hidden = false;
        }
      }
    }

    function updateModuleActive(modulAktif: number | null) {
      for (const modul of [1, 2, 3, 4]) {
        const row = document.querySelector<HTMLAnchorElement>(`[data-mini-mod="${modul}"]`);
        if (!row) continue;
        const active = modul === modulAktif;
        row.classList.toggle("is-active", active);
        const chip = row.querySelector<HTMLElement>(".mini-mod__chip");
        // A locked module keeps its "Terkunci" chip regardless of which
        // module the running session happens to be on.
        if (!chip || row.classList.contains("is-locked")) continue;
        chip.textContent = active ? "Aktif" : "";
        chip.hidden = !active;
      }
    }

    // Module 4A's board runs on the Orange Pi itself, on the local
    // IRIS-IOT network, never through this site's own domain -- see the
    // Phase 2 plan's topology section for why that address is fixed rather
    // than looked up. A phone reaching this dashboard page is not
    // necessarily on that network yet (this site works over the internet;
    // the IoT board does not), so the link only works once the phone has
    // joined IRIS-IOT, which the card's copy says plainly.
    const IOT_BOARD_URL = "http://192.168.4.1:8080/";

    function iotBoardUrl(nim?: string): string {
      if (!nim) return IOT_BOARD_URL;
      const url = new URL(IOT_BOARD_URL);
      url.searchParams.set("nim", nim);
      return url.toString();
    }

    function show(id: string) {
      document.getElementById(id)!.hidden = false;
    }
    function hide(id: string) {
      document.getElementById(id)!.hidden = true;
    }

    let stopBannerPolling: (() => void) | null = null;
    let stopIdentityPolling: (() => void) | null = null;

    // The reactive sky (Stage 6): a session starting wakes the orphaned
    // "sesi" scene, tinted per the running module via setModuleTint().
    // Tracked so repeated renderBanner() calls from a 30s poll only touch
    // Cosmos on an actual transition, not on every tick.
    let cosmosInSesiScene = false;

    function renderBanner(
      s: { modul: number; tanggal: string; mulai: string; mulaiPada: string | null } | null,
    ) {
      show("session-banner-host");
      updateModuleActive(s?.modul ?? null);

      if (!s) {
        hide("session-banner");
        show("session-banner-kosong");
        // No running session means no running module, so the Module 4
        // scoreboard card (which only makes sense while Module 4A/B is
        // actually the session in progress) has nothing to point at.
        hide("modul4-card");
        if (cosmosInSesiScene) {
          cosmosInSesiScene = false;
          window.Cosmos?.setScene("kerja");
          window.Cosmos?.setModuleTint(0);
        }
        return;
      }

      hide("session-banner-kosong");
      show("session-banner");
      document.getElementById("banner-modul-nomor")!.textContent = String(s.modul);
      document.getElementById("banner-modul-nama")!.textContent = MODULE_NAMES[s.modul] ?? "";
      const { label, persen } = formatProgress(s.mulai, s.mulaiPada);
      document.getElementById("banner-durasi")!.textContent = label;
      (document.getElementById("banner-bar-fill") as HTMLElement).style.width = `${persen}%`;
      document.getElementById("banner-buka-modul-nomor")!.textContent = String(s.modul);
      (document.getElementById("banner-buka-modul") as HTMLAnchorElement).href =
        `/modules/${s.modul}`;
      // The Orange Pi scoreboard card is Module 4's alone -- surfacing it
      // during Modules 1-3 sent students hunting for a hotspot that has
      // nothing to do with the module actually running.
      if (s.modul === 4) {
        show("modul4-card");
      } else {
        hide("modul4-card");
      }
      window.Cosmos?.setModuleTint(s.modul);
      if (!cosmosInSesiScene) {
        cosmosInSesiScene = true;
        window.Cosmos?.setScene("sesi");
      }
    }

    // Stage 10's broadcast: shown as a toast the first time this tab sees
    // a given pengumumanPada, so the same poll response doesn't re-toast
    // an announcement the student already dismissed, and a page reload
    // doesn't re-show yesterday's. Session-scoped (not persisted) is
    // deliberate -- an announcement is meant for whoever is looking right
    // now, not something to resurface after the fact.
    let lastPengumumanPada: string | null = null;
    function maybeToastPengumuman(pengumuman: string | null, pengumumanPada: string | null) {
      if (!pengumuman || !pengumumanPada || pengumumanPada === lastPengumumanPada) return;
      lastPengumumanPada = pengumumanPada;
      window.Toast?.show(pengumuman, "info");
    }

    async function init() {
      // P6.9: this fetch had no try/catch, unlike every other one in this
      // file (see the startPolling callback below, fixed for the same
      // reason) -- a response whose body isn't JSON (a platform error page
      // during an outage, not just this project's own {ok:false, kode}
      // shape) threw out of init() unhandled, leaving the page stuck on
      // "Memuat..." forever with no way to recover short of the user
      // guessing to reload.
      // eslint-disable-next-line @typescript-eslint/no-explicit-any -- matches this file's other untyped fetch responses (e.g. the startPolling callback below)
      let me: any;
      try {
        me = await fetch("/api/auth/me").then((r) => r.json());
      } catch {
        const title = document.querySelector<HTMLElement>("#loading .empty__title");
        if (title) title.textContent = "Gagal memuat. Muat ulang halaman.";
        return;
      }
      if (!me.ok) {
        navigate("/?login=1");
        return;
      }
      if (me.role !== "praktikan") {
        navigate("/session");
        return;
      }

      hide("loading");
      show("view-praktikan");
      // The one entrance per page (design-system.md's own rule): the
      // bento tiles rise in together on arrival.
      window.Motion?.enter("#view-praktikan > *");
      void renderModuleLocks();
      document.getElementById("praktikan-nama")!.textContent = me.nama;
      const badge = document.getElementById("praktikan-badge")!;
      badge.textContent = `Kelompok ${me.kelompok}`;
      badge.style.setProperty("--badge-hue", `var(--group-${me.kelompok})`);
      document
        .getElementById("group-card")
        ?.style.setProperty("--g", `var(--group-${me.kelompok})`);
      document
        .getElementById("link-kelompok-live")
        ?.addEventListener("click", () => navigate(`/groups/${me.kelompok}`));
      (document.getElementById("btn-buka-iot") as HTMLButtonElement)?.addEventListener(
        "click",
        () => window.open(iotBoardUrl(me.nim), "_blank", "noopener"),
      );

      stopIdentityPolling?.();
      // See identity-watch.ts: the session cookie is shared by every tab.
      stopIdentityPolling = watchIdentity(me.nim);

      stopBannerPolling?.();
      // A narrow, praktikan-safe poll: module/timing/broadcast only, never
      // the roster. Visibility-aware, so a backgrounded tab costs nothing
      // -- see polling.ts's own header for why that matters for Neon too.
      // Wrapped, found live while checking this stage's own broadcast
      // work: startPolling() fires this on a bare timer with no await at
      // the call site, so an unhandled rejection here (any non-2xx
      // response whose body isn't JSON) surfaced as a recurring uncaught
      // promise rejection every 30 seconds instead of just leaving the
      // banner at its last good state.
      stopBannerPolling = startPolling(async () => {
        try {
          const data = await fetch("/api/session/now").then((r) => r.json());
          if (!data.ok) return;
          renderBanner(data.sesi);
          maybeToastPengumuman(data.sesi?.pengumuman ?? null, data.sesi?.pengumumanPada ?? null);
        } catch {
          // Left at whatever the last successful poll produced.
        }
      }, 30_000);
    }

    // Re-run on every astro:page-load, not just the first visit -- see the
    // Stage 5 comment this replaced for the full "why" (ClientRouter only
    // executes a page's module script once; this page swaps its whole
    // non-persisted DOM on every navigation, so a plain top-level
    // addEventListener only ever binds to the first visit's nodes).
    //
    // The pathname check, not just the #loading presence check the Stage 5
    // version relied on, is what stops this LEFTOVER listener from firing
    // on a LATER page too -- found live while adding this stage's own
    // asisten-to-/session redirect: dashboard.astro and session.astro both
    // render an element with id="loading", so after visiting both once,
    // navigating to either fires astro:page-load, which every page's own
    // accumulated (and never torn down) listener receives. Without this
    // check, dashboard.astro's stale bindPage() would run its own init()
    // against session.astro's DOM, see role !== "praktikan", and call
    // navigate("/session") again while already there.
    function bindPage() {
      if (location.pathname !== "/dashboard") return;
      const loading = document.getElementById("loading");
      // astro:page-load fires once on the very first load AND again after
      // every later navigation, but bindPage() is also called directly
      // below for that same first load -- without this guard, the first
      // visit's listeners (including init()'s own) were bound twice,
      // making every click and the first poll fire double. A later real
      // navigation creates a fresh #loading node with no dataset.bound,
      // so re-binding then still works as intended.
      if (!loading || loading.dataset.bound) return;
      loading.dataset.bound = "1";

      document.getElementById("btn-keluar")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        navigate("/?login=1");
      });

      init();
    }

    bindPage();
    document.addEventListener("astro:page-load", bindPage);
  </script>
</Base>

<style>
  /* -------------------------------------------------------------------
     SESSION BANNER (P7.4) — a compact single-row strip rather than the
     old full-height identity block, following the signed-off mockup.
     Full-bleed (a .page-wide row inside, not .page-regular) since a
     session's identity is worth stating across the room; everything
     below it is a bento of cards that stays at the standard measure.
     ------------------------------------------------------------------- */
  .banner {
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--hairline);
  }

  .banner__inner {
    padding-block: var(--space-4);
  }

  .banner__running {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: space-between;
  }

  .banner__identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .banner__module {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .banner__module-eyebrow {
    color: var(--text-faint);
    font-size: var(--fs-small);
  }

  .banner__module-nama {
    font-family: var(--font-display);
    font-size: var(--fs-display-sm);
  }

  .banner__progress {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    width: 100%;
  }

  .banner__progress-text {
    color: var(--text-faint);
    font-size: var(--fs-small);
    white-space: nowrap;
  }

  .banner__bar {
    background: var(--hairline);
    border-radius: var(--radius-pill);
    flex: 1;
    height: 6px;
    min-width: 8rem;
    overflow: hidden;
  }

  .banner__bar > span {
    background: var(--accent);
    display: block;
    height: 100%;
    transition: width var(--dur-mid) var(--ease-reveal);
  }

  .banner__kosong {
    align-items: center;
    display: flex;
    gap: var(--space-3);
  }

  .banner__kosong-teks {
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .banner__running {
      align-items: center;
      flex-direction: row;
    }

    .banner__progress {
      width: auto;
    }
  }

  /* -------------------------------------------------------------------
     BENTO — main tile (presentation) + a sidebar stack (group, module
     list, and the Module 4 scoreboard card when it's the running
     module). One column, sidebar first, below 1024 -- matching the
     mockup's mobile order, where the group and module status are worth
     seeing before the presentation embed. A real two-column bento only
     once there's room for the 320px sidebar to not crowd the main tile.
     ------------------------------------------------------------------- */
  .bento {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-page-top) var(--space-section);
  }

  .bento__main {
    order: 2;
  }

  .bento__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    order: 1;
  }

  @media (min-width: 1024px) {
    .bento {
      align-items: start;
      display: grid;
      grid-template-columns: 1fr 320px;
    }

    .bento__main,
    .bento__side {
      order: initial;
    }
  }

  .group-card {
    border-left: 3px solid var(--g, var(--hairline));
  }

  .group-card__nama {
    color: var(--text-muted);
    font-size: var(--fs-body-lg);
    margin-top: var(--space-3);
  }

  .group-card__link {
    margin-top: var(--space-4);
    width: 100%;
  }

  .module-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mini-mod {
    align-items: center;
    border-radius: var(--radius-md);
    color: inherit;
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-reveal);
  }

  .mini-mod:hover {
    background: var(--bg-sunken);
  }

  .mini-mod__dot {
    background: var(--hairline-strong);
    border-radius: 50%;
    flex-shrink: 0;
    height: 8px;
    width: 8px;
  }

  .mini-mod.is-active .mini-mod__dot {
    background: var(--accent);
  }

  .mini-mod__nama {
    flex: 1;
    font-size: var(--fs-body);
  }

  .mini-mod.is-locked {
    opacity: 0.6;
  }

  .mini-mod.is-locked .mini-mod__nama {
    color: var(--text-muted);
  }

  .modul4-card p {
    margin-bottom: var(--space-5);
  }
</style>
