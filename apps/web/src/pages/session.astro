---
/**
 * The assistant console. As of P6.6 this page is a thin shell: a role
 * check, the Nav/Toast/Modal chrome, and mounting SessionConsole.tsx, which
 * owns everything that used to live in this file's own vanilla script
 * (session start/end/cancel/lanjutkan, the roster paste box) and in
 * SessionPanels.tsx (per-group tiles, stuck list, broadcast, server
 * readiness, presentation manager) -- see SessionConsole.tsx's own header
 * comment for why those merged into one island instead of staying split.
 *
 * Same "static shell, client fills in from /api/auth/me" pattern as every
 * other role-branched page (output: 'static' has no request-time cookie
 * access), and the same "show a forbidden state rather than redirect" rule
 * dashboard/server.astro already established for a praktikan landing here.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/ui/Nav.astro";
import { navUtama } from "../lib/nav-links";
import Button from "../components/ui/Button.astro";
import Modal from "../components/ui/Modal.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Toast from "../components/ui/Toast";
import SessionConsole from "../components/SessionConsole";

const links = navUtama();
---

<Base title="Sesi · IRIS IoT" cosmosScene="kerja">
  <Nav links={links} current="/session">
    <Fragment slot="side">
      <Button kind="ghost" id="btn-keluar" class="hidden-until-known">
        Keluar
      </Button>
    </Fragment>
  </Nav>
  <Toast client:load />

  <main class="measure--wide">
    <div id="loading">
      <EmptyState title="Memuat…" />
    </div>

    <div id="view-terlarang" hidden>
      <EmptyState
        title="Halaman ini khusus asisten"
        hint="Masuk sebagai asisten untuk membuka konsol sesi."
      />
    </div>

    <div id="view-asisten" hidden>
      <SessionConsole client:load />
    </div>
  </main>

  <Modal id="modal-konfirmasi" title="Yakin?">
    <Fragment slot="body">
      <p class="konfirmasi-teks" id="konfirmasi-teks"></p>
    </Fragment>
    <Fragment slot="actions">
      <Button kind="ghost" data-modal-close type="button">
        Batal
      </Button>
      <Button kind="primary" id="konfirmasi-ya" type="button">
        Ya
      </Button>
    </Fragment>
  </Modal>

  <script>
    import { navigate } from "astro:transitions/client";

    function show(id: string) {
      document.getElementById(id)!.hidden = false;
    }
    function hide(id: string) {
      document.getElementById(id)!.hidden = true;
    }

    async function init() {
      const me = await fetch("/api/auth/me").then((r) => r.json());
      hide("loading");
      if (!me.ok) {
        navigate("/?login=1");
        return;
      }
      if (me.role !== "asisten") {
        show("view-terlarang");
        window.Motion?.enter("#view-terlarang > *");
        return;
      }

      document.querySelector(".hidden-until-known")?.classList.remove("hidden-until-known");
      show("view-asisten");
      window.Motion?.enter("#view-asisten > .session-console > *");
    }

    // Re-run on every astro:page-load, not just the first visit -- see
    // dashboard.astro's own bindPage() comment for the full "why".
    function bindPage() {
      if (location.pathname !== "/session") return;
      const loading = document.getElementById("loading");
      if (!loading || loading.dataset.bound) return;
      loading.dataset.bound = "1";

      document.getElementById("btn-keluar")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        navigate("/?login=1");
      });

      init();
    }

    bindPage();
    document.addEventListener("astro:page-load", bindPage);
  </script>
</Base>

<style>
  .konfirmasi-teks {
    color: var(--text-muted);
  }

  .hidden-until-known {
    visibility: hidden;
  }
</style>
