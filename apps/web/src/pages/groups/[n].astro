---
/**
 * That group's own readings and ladder, in its hue -- the plan's own words.
 * No role gate: a praktikan reaches their own group's URL from /dashboard,
 * an assistant reaches any group's from the session console, and neither
 * carries anything sensitive here (everything on this page is simulated,
 * same disclosure as /modules/[n]/live).
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/ui/Nav.astro";
import { navUtama } from "../../lib/nav-links";
import GroupLive from "../../components/GroupLive";

export function getStaticPaths() {
  return [1, 2, 3, 4, 5].map((n) => ({ params: { n: String(n) } }));
}

const { n } = Astro.params;
const group = Number(n);

const links = navUtama();
---

<Base title={`Kelompok ${group} · IRIS IoT`} cosmosScene="kerja">
  <Nav links={links} current="/dashboard" />

  <main class="measure--wide">
    <header class="group-header" style={`--tile-hue: var(--group-${group})`}>
      <p class="eyebrow eyebrow--accent">Kelompok {group}</p>
      <h1 class="group-header__title">Ladder dan bacaan kelompok {group}</h1>
      <p class="group-header__disclosure measure-prose">
        Semua data pada halaman ini disimulasikan di peramban Anda, bukan diambil dari papan atau
        sesi yang sebenarnya. Pilih modul untuk melihat ladder dan bacaannya.
      </p>
    </header>

    <div class="group-panel">
      <GroupLive client:load group={group} />
    </div>
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../../scripts/per-halaman";
  function playEntrance() {
    window.Motion?.enter(".group-header > *");
  }
  sekaliPerHalaman("GrupAnimasi", playEntrance);
</script>

<style>
  .group-header {
    border-left: 3px solid var(--tile-hue);
    padding-block: var(--space-8) var(--space-6);
    padding-inline-start: var(--space-5);
  }

  .group-header__title {
    font-family: var(--font-display);
    font-size: var(--fs-display-lg);
    font-weight: 400;
    margin-top: var(--space-2);
  }

  .group-header__disclosure {
    color: var(--text-muted);
    margin-top: var(--space-3);
  }

  .group-panel {
    padding-block: var(--space-6) var(--space-10);
  }
</style>
