---
/**
 * Homepage. Deliberately minimal for Phase 1: the four modules' real
 * content, the live layer X-ray, and the server/device registry are each
 * their own phase (see the Phase 1 plan's roadmap) and don't exist yet.
 * What has to be true today is that the site has a front door, it says
 * what it is, and it gets a practitioner or an assistant into the login
 * modal.
 *
 * Login lives here, not on its own route: Phase 5 replaced the standalone
 * /masuk page with a login dialog (now LoginDialog.tsx, mounted globally by
 * Base.astro since P7.3), opened either directly (the "Masuk" action below)
 * or by arriving at /?login=1 -- which /masuk and /login both redirect to,
 * see vercel.json -- checked for on load just below.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/ui/Nav.astro";
import { navUtama } from "../lib/nav-links";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Chip from "../components/ui/Chip.astro";
import ModuleIcon from "../components/icons/ModuleIcon.astro";

// The shared list (see nav-links.ts), which also hides role-scoped links
// once /api/auth/me answers -- this page used to hand-relabel Dasbor into
// Sesi for an assistant itself.
const links = navUtama();

const MODULES = [
  {
    modul: 1 as const,
    title: "Bluetooth Low Energy",
    body: "Central/Peripheral GATT, dua ESP32 tanpa jaringan IP.",
  },
  {
    modul: 2 as const,
    title: "WebSocket",
    body: "ESP32 ke server Python di Orange Pi, lewat Wi-Fi lokal.",
  },
  {
    modul: 3 as const,
    title: "MQTT",
    body: "Publish/subscribe lewat broker Eclipse Mosquitto.",
  },
  {
    modul: 4 as const,
    title: "LoRa",
    body: "Perburuan LoRa P2P antar papan ESP32.",
  },
];
---

<Base
  title="IRIS IoT"
  description="Praktikum IoT IRIS. Empat modul, satu papan."
  cosmosScene="beranda"
>
  <Nav links={links} current="/" />

  <main class="page-regular">
    <!--
      P7.4 rebuild, following the signed-off P7.2 mockup: hero and the
      module grid sit inside one centered block (max-width 1080px) rather
      than each spanning its own full grid column all the way to the page
      edge -- the fix for the "far separated" landing-centering feedback
      from P7.2 round 1. Below 1024 the block stacks: hero first, then the
      module grid at 2 columns (820) and 1 column (360).
    -->
    <div class="landing">
      <section class="hero">
        <p class="eyebrow eyebrow--accent">Praktikum IoT &middot; Laboratorium IRIS</p>
        <h1 class="hero__title">
          Empat modul.
          <br />
          Satu papan.
        </h1>
        <p class="hero__lede">
          BLE, WebSocket, MQTT, dan LoRa: satu tempat untuk jurnal, jadwal sesi, dan papan skor
          praktikum IoT IRIS.
        </p>
        <div class="hero__actions">
          <Button kind="primary" size="lg" id="hero-btn-masuk">
            Masuk
          </Button>
        </div>
      </section>

      <div class="modules">
        {MODULES.map(({ modul, title, body }, i) => (
          <a class="modules__link" href={`/modules/${modul}`}>
            <Card interactive class="stagger-item modules__card" style={`--i: ${i}`}>
              <div class="modules__card-head">
                <ModuleIcon modul={modul} />
                <Chip>MODUL {modul}</Chip>
              </div>
              <h3 class="modules__card-title">{title}</h3>
              <p class="modules__card-body">{body}</p>
              <p class="modules__footer">Buka modul &rarr;</p>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../scripts/per-halaman";
  import { navigate } from "astro:transitions/client";
  import { lockCards } from "../scripts/modul-akses";

  // /masuk and /login both redirect here with this query param (see
  // vercel.json), so a bookmark or a link written before the modal
  // existed still lands somewhere useful. Checked against a live session
  // first -- unlike a plain visit to "/", which never makes this call --
  // because arriving via this specific path is someone who came here
  // TO log in, and if they already have, the form would just be in the
  // way.
  function openLoginIfRequested() {
    if (new URLSearchParams(location.search).get("login") !== "1") return;
    fetch("/api/auth/me")
      .then((r) => r.json())
      .then((data) => {
        if (data.ok) {
          navigate(data.role === "asisten" ? "/session" : "/dashboard");
        } else {
          window.LoginDialog?.open();
        }
      })
      .catch(() => {
        window.LoginDialog?.open();
      });
  }

  function bindHeroMasuk() {
    document.getElementById("hero-btn-masuk")?.addEventListener("click", () => {
      window.LoginDialog?.open();
    });
  }

  // The one entrance per page (design-system.md's own rule, unapplied
  // anywhere on apps/web until Stage 6): the hero rises and fades in on
  // arrival. Motion.enter() already no-ops under reduced motion or a
  // missing GSAP, so this never needs its own guard.
  function playEntrance() {
    window.Motion?.enter(".hero > *");
  }
  sekaliPerHalaman("BerandaBukaMasuk", openLoginIfRequested);
  sekaliPerHalaman("BerandaIkatMasuk", bindHeroMasuk);
  sekaliPerHalaman("BerandaMasukAnimasi", playEntrance);
  // P6.5: badges the four module cards' locked state.
  sekaliPerHalaman("BerandaModulAkses", () => void lockCards(document, "Belum dibuka"));
</script>

<style>
  .landing {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-page-top) var(--space-section);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: 0 var(--space-8);
  }

  .hero__title {
    /* Explicit opt-in to the serif (see base.css h1-h4's own comment). */
    /* This is an h1, and --fs-display-xl (a clamp() with a 4rem minimum) */
    /* never drops below the --fs-display-md floor at any viewport width. */
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-display-xl);
  }

  .hero__lede {
    color: var(--text-muted);
    font-size: var(--fs-body-lg);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .modules {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  .modules__link {
    color: inherit;
    display: flex;
    height: 100%;
    text-decoration: none;
  }

  .modules__card-head {
    align-items: flex-start;
    display: flex;
    justify-content: space-between;
  }

  .modules__card-title {
    font-size: var(--fs-display-sm);
    margin-top: var(--space-5);
  }

  .modules__card-body {
    margin-top: var(--space-2);
  }

  /* Pinned to the bottom of the card regardless of how much lede text sits
     above it (Card.astro's own __body is a flex column for exactly this),
     so all four module cards' footer rows line up even though their copy
     is not the same length. */
  .modules__footer {
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 500;
    margin-top: auto;
    padding-top: var(--space-4);
  }

  /* 360 (base, above): one column, hero above the module grid.
     640 and up: the module grid becomes 2 columns (the plan's own
     "2-column at 820" note), still stacked under the hero below 1024.
     1024 and up: hero and the module grid share one row, wrapped in a
     single centered 1080px-max block -- the P7.2 mockup's fix for the
     "far separated" edge-pinned layout, rather than each half spanning
     its own full-width grid column out to the page edge. */
  @media (min-width: 640px) {
    .modules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .landing {
      align-items: center;
      display: grid;
      gap: var(--space-9);
      grid-template-columns: minmax(0, 440px) minmax(0, 520px);
      justify-content: center;
      margin-inline: auto;
      max-width: 1080px;
    }

    .hero {
      padding-block: 0;
    }

    .hero__title {
      font-size: var(--fs-display-lg);
    }
  }
</style>
