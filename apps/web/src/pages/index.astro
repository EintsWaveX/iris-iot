---
/**
 * Homepage. Deliberately minimal for Phase 1: the four modules' real
 * content, the live layer X-ray, and the server/device registry are each
 * their own phase (see the Phase 1 plan's roadmap) and don't exist yet.
 * What has to be true today is that the site has a front door, it says
 * what it is, and it gets a practitioner or an assistant into the login
 * modal.
 *
 * Login lives here, not on its own route: Phase 5 replaced the standalone
 * /masuk page with LoginModal.astro, opened either directly (the "Masuk"
 * actions below) or by arriving at /?login=1 -- which /masuk and /login
 * both redirect to, see vercel.json -- checked for on load just below.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/ui/Nav.astro";
import { navUtama } from "../lib/nav-links";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import LoginModal from "../components/LoginModal.astro";

// The shared list (see nav-links.ts), which also hides role-scoped links
// once /api/auth/me answers -- this page used to hand-relabel Dasbor into
// Sesi for an assistant itself.
const links = navUtama();
---

<Base
  title="IRIS IoT"
  description="Praktikum IoT IRIS. Empat modul, satu papan."
  cosmosScene="beranda"
>
  <Nav links={links} current="/">
    <Fragment slot="side">
      <Button kind="ghost" data-modal-open="login-modal" id="btn-masuk">
        Masuk
      </Button>
      <Button kind="ghost" id="btn-keluar" hidden>
        Keluar
      </Button>
    </Fragment>
  </Nav>
  <LoginModal />

  <main class="measure">
    <!--
      Below lg (1024px and under): the hero stacks above the four module
      cards in a grid, unchanged from before this pass. At lg and above,
      hero-layout becomes a real two-column design -- the display line
      and actions hold the left column, and the four modules become a
      vertical signal chain on the right rather than a 2x2 grid, read as
      stations on a path (BLE, WebSocket, MQTT, LoRa) rather than four
      equal, unordered cards.
    -->
    <div class="hero-layout">
      <section class="hero">
        <p class="eyebrow eyebrow--accent">Praktikum IoT &middot; Laboratorium IRIS</p>
        <h1 class="hero__title">
          Empat modul.
          <br />
          Satu papan.
        </h1>
        <p class="hero__lede">
          BLE, WebSocket, MQTT, dan LoRa: satu tempat untuk jurnal, jadwal sesi, dan papan skor
          praktikum IoT IRIS.
        </p>
        <div class="hero__actions">
          <Button kind="primary" data-modal-open="login-modal">
            Masuk
          </Button>
        </div>
      </section>

      <div class="modules">
        <a class="modules__link" href="/modules/1">
          <Card
            interactive
            class="stagger-item"
            style="--i: 0"
            eyebrow="Modul 1"
            title="Bluetooth Low Energy"
          >
            <p>Central/Peripheral GATT, dua ESP32 tanpa jaringan IP.</p>
            <p class="modules__footer">Buka modul &rarr;</p>
          </Card>
        </a>
        <a class="modules__link" href="/modules/2">
          <Card interactive class="stagger-item" style="--i: 1" eyebrow="Modul 2" title="WebSocket">
            <p>ESP32 ke server Python di Orange Pi, lewat Wi-Fi lokal.</p>
            <p class="modules__footer">Buka modul &rarr;</p>
          </Card>
        </a>
        <a class="modules__link" href="/modules/3">
          <Card interactive class="stagger-item" style="--i: 2" eyebrow="Modul 3" title="MQTT">
            <p>Publish/subscribe lewat broker Eclipse Mosquitto.</p>
            <p class="modules__footer">Buka modul &rarr;</p>
          </Card>
        </a>
        <a class="modules__link" href="/modules/4">
          <Card interactive class="stagger-item" style="--i: 3" eyebrow="Modul 4" title="LoRa">
            <p>Perburuan LoRa P2P antar papan ESP32.</p>
            <p class="modules__footer">Buka modul &rarr;</p>
          </Card>
        </a>
      </div>
    </div>
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../scripts/per-halaman";
  import { navigate } from "astro:transitions/client";
  import { lockCards } from "../scripts/modul-akses";

  // /masuk and /login both redirect here with this query param (see
  // vercel.json), so a bookmark or a link written before the modal
  // existed still lands somewhere useful. Checked against a live session
  // first -- unlike a plain visit to "/", which never makes this call --
  // because arriving via this specific path is someone who came here
  // TO log in, and if they already have, the form would just be in the
  // way.
  function openLoginIfRequested() {
    if (new URLSearchParams(location.search).get("login") !== "1") return;
    fetch("/api/auth/me")
      .then((r) => r.json())
      .then((data) => {
        if (data.ok) {
          navigate(data.role === "asisten" ? "/session" : "/dashboard");
        } else {
          window.Modal?.open("login-modal");
        }
      })
      .catch(() => {
        window.Modal?.open("login-modal");
      });
  }

  // A plain visit to "/" (no ?login=1) never used to check session state
  // at all, so a returning, already-signed-in visitor saw the logged-out
  // "Masuk" button and nothing pointing back at their own dashboard --
  // the bug behind "Dasbor and the rest of the tabs are not present"
  // once logged in, since the brand mark always links here. This swaps
  // Masuk for Keluar once a session is confirmed; the nav links
  // themselves are unconditional now (see the links array above) and
  // simply gate at their destination the same way /dashboard already
  // does for a logged-out visitor.
  function bindKeluar() {
    const btn = document.getElementById("btn-keluar");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      navigate("/");
    });
  }

  function checkAuthState() {
    if (location.pathname !== "/") return;
    const masuk = document.getElementById("btn-masuk");
    const keluar = document.getElementById("btn-keluar");
    if (!masuk || !keluar) return;
    bindKeluar();
    fetch("/api/auth/me")
      .then((r) => r.json())
      .then((data) => {
        if (location.pathname !== "/") return;
        masuk.hidden = !!data.ok;
        keluar.hidden = !data.ok;
      })
      .catch(() => {
        // A failed check is not evidence of a session either way --
        // leave the default logged-out state (Masuk shown) in place.
      });
  }

  // The one entrance per page (design-system.md's own rule, unapplied
  // anywhere on apps/web until Stage 6): the hero rises and fades in on
  // arrival. Motion.enter() already no-ops under reduced motion or a
  // missing GSAP, so this never needs its own guard.
  function playEntrance() {
    window.Motion?.enter(".hero > *");
  }
  sekaliPerHalaman("BerandaBukaMasuk", openLoginIfRequested);
  sekaliPerHalaman("BerandaCekMasuk", checkAuthState);
  sekaliPerHalaman("BerandaMasukAnimasi", playEntrance);
  // P6.5: badges the four module cards' locked state.
  sekaliPerHalaman("BerandaModulAkses", () => void lockCards(document, "Belum dibuka"));
</script>

<style>
  .hero-layout {
    display: flex;
    flex-direction: column;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-10) var(--space-8);
  }

  .hero__title {
    /* Explicit opt-in to the serif (see base.css h1-h4's own comment). */
    /* This is an h1, and --fs-display-xl (a clamp() with a 4rem minimum) */
    /* never drops below the --fs-display-md floor at any viewport width. */
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-display-xl);
  }

  .hero__lede {
    color: var(--text-muted);
    font-size: var(--fs-body-lg);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .modules {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    padding-block: var(--space-8);
  }

  .modules__link {
    color: inherit;
    display: flex;
    height: 100%;
    text-decoration: none;
  }

  /* Pinned to the bottom of the card regardless of how much lede text sits
     above it (Card.astro's own __body is a flex column for exactly this),
     so all four module cards' footer rows line up even though their copy
     is not the same length. */
  .modules__footer {
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 500;
    margin-top: auto;
    padding-top: var(--space-4);
  }

  /* lg and above: two real columns rather than a wider version of the
     stacked layout. The display line stays at a comfortable size (not
     --fs-display-xl's full room-filling clamp) since it now shares the
     viewport with the module chain instead of owning it outright, and
     the four modules become a vertical run -- stations on a signal path,
     not an unordered 2x2 grid -- in their own column beside it. */
  @media (min-width: 1025px) {
    .hero-layout {
      align-items: center;
      display: grid;
      gap: var(--space-9);
      grid-template-columns: 1.1fr 0.9fr;
    }

    .hero {
      padding-block: 0;
    }

    .hero__title {
      font-size: var(--fs-display-lg);
    }

    .modules {
      grid-template-columns: 1fr;
      padding-block: 0;
    }
  }
</style>
