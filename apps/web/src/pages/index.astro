---
/**
 * Homepage. Deliberately minimal for Phase 1: the four modules' real
 * content, the live layer X-ray, and the server/device registry are each
 * their own phase (see the Phase 1 plan's roadmap) and don't exist yet.
 * What has to be true today is that the site has a front door, it says
 * what it is, and it gets a practitioner or an assistant into the login
 * modal.
 *
 * Login lives here, not on its own route: Phase 5 replaced the standalone
 * /masuk page with LoginModal.astro, opened either directly (the "Masuk"
 * actions below) or by arriving at /?login=1 -- which /masuk and /login
 * both redirect to, see vercel.json -- checked for on load just below.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/ui/Nav.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import LoginModal from "../components/LoginModal.astro";

const links = [{ href: "/", label: "Beranda" }];
---

<Base
  title="IRIS IoT"
  description="Praktikum IoT IRIS. Empat modul, satu papan."
  cosmosScene="beranda"
>
  <Nav links={links} current="/">
    <Fragment slot="side">
      <Button kind="ghost" data-modal-open="login-modal">
        Masuk
      </Button>
    </Fragment>
  </Nav>
  <LoginModal />

  <main class="measure">
    <section class="hero">
      <p class="eyebrow eyebrow--accent">Praktikum IoT &middot; Laboratorium IRIS</p>
      <h1 class="hero__title">
        Empat modul.
        <br />
        Satu papan.
      </h1>
      <p class="hero__lede">
        BLE, WebSocket, MQTT, dan LoRa: satu tempat untuk jurnal, jadwal sesi, dan papan skor
        praktikum IoT IRIS.
      </p>
      <div class="hero__actions">
        <Button kind="primary" data-modal-open="login-modal">
          Masuk
        </Button>
        <Button kind="ghost" href="/ui">
          Panduan gaya
        </Button>
      </div>
    </section>

    <section class="section">
      <div class="modules">
        <Card eyebrow="Modul 1" title="Bluetooth Low Energy">
          <p>Central/Peripheral GATT, dua ESP32 tanpa jaringan IP.</p>
        </Card>
        <Card eyebrow="Modul 2" title="WebSocket">
          <p>ESP32 ke server Python di Orange Pi, lewat Wi-Fi lokal.</p>
        </Card>
        <Card eyebrow="Modul 3" title="MQTT">
          <p>Publish/subscribe lewat broker Eclipse Mosquitto.</p>
        </Card>
        <Card eyebrow="Modul 4" title="LoRa">
          <p>Perburuan LoRa P2P antar papan ESP32.</p>
        </Card>
      </div>
    </section>
  </main>
</Base>

<script>
  import { navigate } from "astro:transitions/client";

  // /masuk and /login both redirect here with this query param (see
  // vercel.json), so a bookmark or a link written before the modal
  // existed still lands somewhere useful. Checked against a live session
  // first -- unlike a plain visit to "/", which never makes this call --
  // because arriving via this specific path is someone who came here
  // TO log in, and if they already have, the form would just be in the
  // way.
  function openLoginIfRequested() {
    if (new URLSearchParams(location.search).get("login") !== "1") return;
    fetch("/api/auth/me")
      .then((r) => r.json())
      .then((data) => {
        if (data.ok) {
          navigate("/dashboard");
        } else {
          window.Modal?.open("login-modal");
        }
      })
      .catch(() => {
        window.Modal?.open("login-modal");
      });
  }

  openLoginIfRequested();
  document.addEventListener("astro:page-load", openLoginIfRequested);
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-10) var(--space-8);
  }

  .hero__title {
    /* Explicit opt-in to the serif (see base.css h1-h4's own comment). */
    /* This is an h1, and --fs-display-xl (a clamp() with a 4rem minimum) */
    /* never drops below the --fs-display-md floor at any viewport width. */
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-display-xl);
  }

  .hero__lede {
    color: var(--text-muted);
    font-size: var(--fs-body-lg);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .modules {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
</style>
