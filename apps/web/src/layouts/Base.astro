---
import { tri } from "../lib/labels";
/**
 * IRIS IoT practicum site — the one page shell.
 *
 * Every page imports this and nothing else for its <head>. tokens.css and
 * base.css are the shared design system, moved to packages/kosmik/ when web
 * and games split out of iris-iot-aso into their own repository, so both
 * apps consume one real source instead of two copies drifting apart by
 * hand. Imported by relative path rather than as an npm workspace package:
 * a real package (with its own package.json, in the root workspaces list)
 * would mean one consolidated lockfile for the whole repo, which changes
 * how CI's `npm ci` has to run for every workspace member, not just this
 * import -- more than a CSS import needs. The JS side (motion.core.js)
 * turned out not to need a workspace either: Vite bundles a relative-path
 * JS import exactly like a CSS one, so src/scripts/cosmos-web.js
 * (imported from components/Cosmos.astro) is a normal ES module import,
 * not a `<script src>` tag.
 */
import "../styles/fonts.css";
import "../../../../packages/kosmik/style/tokens.css";
// Phase 9: the web app's dark refresh and the Daylight sky light theme,
// over kosmik's shared tokens (apps/games keeps those untouched).
import "../styles/theme.css";
import "../../../../packages/kosmik/style/base.css";
import "../../../../packages/kosmik/style/motion.css";
// Global, not a scoped Button.astro <style> block (P6.3) -- a React island
// or a vanilla script creating a control at runtime needs the same `.btn`
// classes Button.astro emits, and Astro's per-component scoping could never
// have reached either one.
import "../styles/controls.css";
// Global for the same reason controls.css is (P7.1) -- ReportsView.tsx,
// ServerCenter.tsx and SessionConsole.tsx apply these classes by hand once
// each is rebuilt onto PageHeader in P7.4.
import "../styles/page-header.css";
// Global, promoted from Field.astro's own scoped style (P7.3) -- the login
// dialog is a React island and needs the same `.field*` classes.
import "../styles/field.css";
// Phase 8: web-only sky layers, the rainbow sweep and themed scrollbars,
// added on top of the kosmik baseline rather than replacing any of it.
import "../styles/sky.css";
import "../styles/app.css";
// Phase 8: the pill is used as a plain class all over the islands.
import "../components/ui/Pill.css";
import { ClientRouter } from "astro:transitions";
import Cosmos from "../components/Cosmos.astro";
import AppNav from "../components/shell/AppNav";
import Toast from "../components/ui/Toast";
import SegFit from "../components/shell/SegFit";
import { langTag, type Lang } from "../lib/kelas";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /**
   * The kosmik scene this page would ask for (data-cosmos-scene below).
   * Phase 9: the web app's sky (sky.ts) has no scenes, so this is only
   * read when apps/games' cosmos.core.js is present (see
   * cosmos-router.js); kept so page metadata stays in one place.
   */
  cosmosScene?: "beranda" | "masuk" | "kerja" | "teknis" | "sesi";
  /** Phase 8: the app nav (AppNav.tsx) is mounted here for every page;
   *  a page can opt out (none does today). */
  nav?: boolean;
  /** The 404 page: Vercel serves one built file for every missing path, so
   *  the nav reads the language from the address after hydration. */
  langFromUrl?: boolean;
}

const {
  title,
  description = "",
  lang = "id",
  cosmosScene = "beranda",
  nav = true,
  langFromUrl = false,
} = Astro.props;
---

<!doctype html>
<html lang={langTag(lang)} data-cosmos-scene={cosmosScene}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Theme, detail level and Mandarin heading weight before first paint. -->
    <script is:inline src="/theme-init.js"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Cosmos />
    <a
      class="skip-link"
      href="#main"
      data-skip-en="Skip to content"
      data-skip-zh="跳到正文"
      data-from-url={langFromUrl ? "yes" : undefined}
    >
      {tri(lang, "Lewati ke isi", "Skip to content", "跳到正文")}
    </a>
    {
      langFromUrl && (
        <script is:inline>
          (function () {
            var a = document.querySelector(".skip-link[data-from-url]");
            var m = location.pathname.match(/^\/(en|zh)(\/|$)/);
            if (a && m) a.textContent = a.getAttribute("data-skip-" + m[1]);
          })();
        </script>
      )
    }
    {nav && <AppNav client:load lang={lang} path={Astro.url.pathname} langFromUrl={langFromUrl} />}
    <Toast client:load />
    <SegFit client:load />
    <slot />
  </body>
</html>

<style is:global>
  /*
   * The page-to-page transition: a content-only crossfade, replacing the
   * hyperspace warp cosmos-router.js used to fire on every navigation.
   * The sky (src/scripts/sky.ts's canvas) is transition:persist'd in
   * Cosmos.astro under its own
   * transition:name="cosmos" group, so it never appears here at all --
   * this only ever touches Astro's implicit "root" group, which is
   * everything else on the page (Nav, main, every page's own content).
   * That split is the whole point: the sky never reacts to navigation,
   * while the content still marks the moment a page changed with
   * something quick and cheap.
   *
   * ::view-transition-old/new(root) are NOT normal DOM elements -- Astro's
   * <ClientRouter/> and the underlying browser View Transitions API
   * create them only during a transition -- so Astro's scoped-style
   * attribute selectors can never reach them; this has to be global CSS,
   * hence is:global rather than a second Base.astro <style> block.
   */
  ::view-transition-old(root) {
    animation: iris-crossfade-out 180ms var(--ease-reveal) both;
  }

  ::view-transition-new(root) {
    animation: iris-crossfade-in 180ms var(--ease-reveal) both;
  }

  @keyframes iris-crossfade-out {
    to {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes iris-crossfade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* motion.css's own global reduced-motion rule targets *, *::before and
     *::after, which does not reach these two pseudo-element TYPES -- they
     need their own opt-out so a real "no motion" preference actually
     means no motion here too, not just everywhere else. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
