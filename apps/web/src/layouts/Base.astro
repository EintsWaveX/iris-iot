---
/**
 * IRIS IoT practicum site — the one page shell.
 *
 * Every page imports this and nothing else for its <head>. tokens.css and
 * base.css are the shared design system, moved to packages/kosmik/ when web
 * and games split out of iris-iot-aso into their own repository, so both
 * apps consume one real source instead of two copies drifting apart by
 * hand. Imported by relative path rather than as an npm workspace package:
 * a real package (with its own package.json, in the root workspaces list)
 * would mean one consolidated lockfile for the whole repo, which changes
 * how CI's `npm ci` has to run for every workspace member, not just this
 * import -- more than a CSS import needs. The JS side (cosmos.core.js /
 * motion.core.js) turned out not to need a workspace either: Vite bundles
 * a relative-path JS import exactly like a CSS one, so
 * packages/kosmik/js/cosmos-web.js (imported from components/Cosmos.astro)
 * is a normal ES module import, not a `<script src>` tag.
 */
import "../styles/fonts.css";
import "../../../../packages/kosmik/style/tokens.css";
import "../../../../packages/kosmik/style/base.css";
import "../../../../packages/kosmik/style/cosmos.css";
import "../../../../packages/kosmik/style/motion.css";
// Global, not a scoped Button.astro <style> block (P6.3) -- a React island
// or a vanilla script creating a control at runtime needs the same `.btn`
// classes Button.astro emits, and Astro's per-component scoping could never
// have reached either one.
import "../styles/controls.css";
import { ClientRouter } from "astro:transitions";
import Cosmos from "../components/Cosmos.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "id" | "en";
  /**
   * Which of packages/kosmik/js/cosmos.core.js's scenes this page's sky
   * runs -- see that file's SCENES object and Stage 3's per-page table.
   * Read by cosmos-router.js off data-cosmos-scene below, not passed to
   * Cosmos itself: the persisted canvas doesn't change per page, only
   * which scene it's showing does.
   */
  cosmosScene?: "beranda" | "masuk" | "kerja" | "teknis" | "sesi";
}

const { title, description = "", lang = "id", cosmosScene = "beranda" } = Astro.props;
---

<!doctype html>
<html lang={lang} data-cosmos-scene={cosmosScene}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Cosmos />
    <slot />
    <script>
      import "../scripts/spotlight.ts";
      import "../scripts/nav-scroll.ts";
    </script>
  </body>
</html>

<style is:global>
  /*
   * The page-to-page transition: a content-only crossfade, replacing the
   * hyperspace warp cosmos-router.js used to fire on every navigation.
   * The sky (packages/kosmik/js/cosmos.core.js's canvas plus cosmos.css's
   * CSS layers) is transition:persist'd in Cosmos.astro under its own
   * transition:name="cosmos" group, so it never appears here at all --
   * this only ever touches Astro's implicit "root" group, which is
   * everything else on the page (Nav, main, every page's own content).
   * That split is the whole point: the sky no longer reacts to
   * navigation, only to setScene()'s own ~1.2s aurora-opacity retune
   * (cosmos-router.js), while the content still marks the moment a page
   * changed with something quick and cheap.
   *
   * ::view-transition-old/new(root) are NOT normal DOM elements -- Astro's
   * <ClientRouter/> and the underlying browser View Transitions API
   * create them only during a transition -- so Astro's scoped-style
   * attribute selectors can never reach them; this has to be global CSS,
   * hence is:global rather than a second Base.astro <style> block.
   */
  ::view-transition-old(root) {
    animation: iris-crossfade-out 180ms var(--ease-reveal) both;
  }

  ::view-transition-new(root) {
    animation: iris-crossfade-in 180ms var(--ease-reveal) both;
  }

  @keyframes iris-crossfade-out {
    to {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes iris-crossfade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* motion.css's own global reduced-motion rule targets *, *::before and
     *::after, which does not reach these two pseudo-element TYPES -- they
     need their own opt-out so a real "no motion" preference actually
     means no motion here too, not just everywhere else. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
