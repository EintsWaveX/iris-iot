---
/**
 * /modules/[n]/live and /en/modules/[n]/live: there is one live page, the module's own Live step
 * (/modules/[n]?step=live, which carries the room, Hubungkan and Upload, with or without a running
 * session). This address only forwards there and keeps ?kelompok=, so old links, the Modules menu
 * and group links all land on the same page instead of a second copy of it.
 */
import Base from "../layouts/Base.astro";
import { tri } from "../lib/labels";
import type { Lang } from "../lib/kelas";
import { href } from "../lib/app";
import "../components/ui/Display.css";

interface Props {
  lang: Lang;
  modul: number;
}

const { lang, modul } = Astro.props;
const target = `${href(lang, "/modules")}/${modul}?step=live`;
---

<Base
  noindex
  title={`${tri(lang, "Live", "Live", "实时")} · IRIS IoT`}
  lang={lang}
  cosmosScene="kerja"
>
  <main id="main" class="page-regular page-main">
    <div class="state-view state-view--accent" data-live-forward data-target={target}>
      <h1 class="state-view__title">
        {tri(lang, "Membuka ruang live…", "Opening the live view…", "正在打开实时视图…")}
      </h1>
      <p class="state-view__body">
        <a href={target}>{tri(lang, "Buka sekarang", "Open it now", "现在打开")}</a>
      </p>
    </div>
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../scripts/per-halaman";

  function forward() {
    const el = document.querySelector<HTMLElement>("[data-live-forward]");
    if (!el?.dataset.target) return;
    const kelompok = new URLSearchParams(location.search).get("kelompok");
    location.replace(
      el.dataset.target + (kelompok ? `&kelompok=${encodeURIComponent(kelompok)}` : ""),
    );
  }
  sekaliPerHalaman("LiveAlihkan", forward);
</script>
