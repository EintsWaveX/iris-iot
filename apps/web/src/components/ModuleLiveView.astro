---
/**
 * /modules/[n]/live and /en/modules/[n]/live (Phase 8): the one live
 * room (live/LiveRoom.tsx, Phase 9): value cards, boards over Web Serial,
 * Serial Monitor, flow and readings, with the student's own group preselected.
 * /groups/[n] redirects here.
 *
 * Every module shows real data once it arrives and simulates it until then:
 * Modules 2 to 4 through the Pi, Module 1 from a group PC reading its
 * Central board over USB. The subtitle says which (t.live.disclosureFor).
 */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import LiveRoom from "../components/live/LiveRoom";
import { stringsFor } from "../i18n/zh";
import type { Lang } from "../lib/kelas";
import { href } from "../lib/app";

interface Props {
  lang: Lang;
  modul: number;
}

const { lang, modul } = Astro.props;
const t = stringsFor(lang);
const entry = await getEntry("modules", `${lang}/${modul}`);
if (!entry) {
  throw new Error(`no module content for ${lang}/${modul}`);
}
const m = entry.data;
const basePath = href(lang, "/modules");
---

<Base
  title={`${t.live.heading} · ${t.moduleWord} ${m.modul} · IRIS IoT`}
  description={t.live.disclosureFor(m.modul)}
  cosmosScene="kerja"
  lang={lang}
>
  <main id="main" class="page-wide page-main" style={`--mod-hue: var(--mod-${m.modul})`}>
    <PageHeader
      back={{ href: `${basePath}/${m.modul}`, label: t.live.backToModule }}
      eyebrow={`${t.moduleWord} ${m.modul}`}
      title={`${m.judul} · ${t.live.heading}`}
      subtitle={t.live.disclosureFor(m.modul)}
    />
    <LiveRoom client:load lang={lang} modul={m.modul} layers={m.lapisan} />
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../scripts/per-halaman";
  import { applyLockScreen, getAksesState, jurnalTertutup } from "../scripts/modul-akses";
  import { dengar } from "../lib/siaran";
  import { stringsFor } from "../i18n/zh";
  import { isLang } from "../lib/kelas";
  function playEntrance() {
    window.Motion?.enter(".page-header > *");
  }
  sekaliPerHalaman("ModulLiveAnimasi", playEntrance);

  // P6.5: see ModuleDetailView.astro's own version of this check for why
  // the module number and language both come from the page itself rather
  // than a prop.
  function checkAkses() {
    const match = /\/modules\/(\d)\/live(?:\/|$)/.exec(location.pathname);
    if (!match) return;
    const l = document.documentElement.lang;
    const lang = l.startsWith("zh") ? "zh" : isLang(l) ? l : "id";
    const t = stringsFor(lang);
    const heading = document.querySelector(".page-header__title");
    const modul = Number(match[1]);
    const kunci = () =>
      applyLockScreen(
        modul,
        t.jurnal.body,
        { id: "terkunci untuk praktikan", en: "locked for students", zh: "对学员锁定" }[lang],
        heading,
      );
    void kunci();
    // Live (2026-10-07): a module closed while this page is open locks it;
    // one opened while the lock screen shows brings the room back.
    const lepas = dengar(["akses", "sesi"], async () => {
      const st = await getAksesState(true, true);
      if (!document.querySelector(".lockscreen")) void kunci();
      else if (!jurnalTertutup(st, modul)) location.reload();
    });
    document.addEventListener("astro:before-swap", lepas, { once: true });
  }
  sekaliPerHalaman("ModulLiveAkses", checkAkses);
</script>
