---
/**
 * /modules/[n]/live and /en/modules/[n]/live (Phase 8): the one live
 * workspace (live/LiveWorkspace.tsx): flow, readings, stats and protocol
 * layers from one stream, with the student's own group preselected.
 * /groups/[n] redirects here.
 *
 * Modules 2 to 4 show real data from a running session and board once it
 * arrives and simulate it until then; Module 1 is always simulated (no real
 * BLE relay exists). The subtitle says which (t.live.disclosureFor).
 */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import LiveWorkspace from "../components/live/LiveWorkspace";
import { id as strId } from "../i18n/id";
import { en as strEn } from "../i18n/en";

interface Props {
  lang: "id" | "en";
  modul: number;
}

const { lang, modul } = Astro.props;
const t = lang === "en" ? strEn : strId;
const entry = await getEntry("modules", `${lang}/${modul}`);
if (!entry) {
  throw new Error(`no module content for ${lang}/${modul}`);
}
const m = entry.data;
const basePath = lang === "en" ? "/en/modules" : "/modules";
---

<Base
  title={`${t.live.heading} · ${t.moduleWord} ${m.modul} · IRIS IoT`}
  description={t.live.disclosureFor(m.modul)}
  cosmosScene="kerja"
  lang={lang}
>
  <main id="main" class="page-wide page-main" style={`--mod-hue: var(--mod-${m.modul})`}>
    <PageHeader
      back={{ href: `${basePath}/${m.modul}`, label: t.live.backToModule }}
      eyebrow={`${t.moduleWord} ${m.modul}`}
      title={`${m.judul} · ${t.live.heading}`}
      subtitle={t.live.disclosureFor(m.modul)}
    />
    <LiveWorkspace client:load lang={lang} modul={m.modul} layers={m.lapisan} />
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../scripts/per-halaman";
  import { applyLockScreen } from "../scripts/modul-akses";
  import { id as strId } from "../i18n/id";
  import { en as strEn } from "../i18n/en";
  function playEntrance() {
    window.Motion?.enter(".page-header > *");
  }
  sekaliPerHalaman("ModulLiveAnimasi", playEntrance);

  // P6.5: see ModuleDetailView.astro's own version of this check for why
  // the module number and language both come from the page itself rather
  // than a prop.
  function checkAkses() {
    const match = /\/modules\/(\d)\/live(?:\/|$)/.exec(location.pathname);
    if (!match) return;
    const t = document.documentElement.lang === "en" ? strEn : strId;
    const heading = document.querySelector(".page-header__title");
    void applyLockScreen(
      Number(match[1]),
      t.code.terkunci,
      document.documentElement.lang === "en" ? "locked for students" : "terkunci untuk praktikan",
      heading,
    );
  }
  sekaliPerHalaman("ModulLiveAkses", checkAkses);
</script>
