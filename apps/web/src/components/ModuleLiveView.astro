---
/**
 * /modules/[n]/live and /en/modules/[n]/live share this view, mirroring how
 * ModuleDetailView.astro is shared by /modules/[n] and /en/modules/[n]. The
 * three tabs (Flow, Layers, Try it yourself) are Tabs.tsx managing sibling
 * panels, the same pattern the carousel itself uses -- this component owns
 * none of the tab-switching logic.
 *
 * Stage 20: Modules 2 to 4 have a real telemetry relay now
 * (src/lib/telemetry-live.ts), so the disclosure line at the top is
 * module-aware (t.live.disclosureFor / t.live.bodyFor in src/i18n) --
 * simulated (src/lib/telemetry-sim.ts) is the honest word only for Module 1,
 * which has no real BLE relay and none planned, and for the fallback state
 * before a module's first real reading arrives.
 */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { navUtama } from "../lib/nav-links";
import Tabs from "../components/ui/Tabs";
import PageHeader from "../components/ui/PageHeader.astro";
import FlowDiagram from "../components/live/FlowDiagram";
import LayerXray from "../components/LayerXray";
import LiveSandbox from "../components/LiveSandbox";
import { id as strId } from "../i18n/id";
import { en as strEn } from "../i18n/en";

interface Props {
  lang: "id" | "en";
  modul: number;
}

const { lang, modul } = Astro.props;
const t = lang === "en" ? strEn : strId;
const entry = await getEntry("modules", `${lang}/${modul}`);
if (!entry) {
  throw new Error(`no module content for ${lang}/${modul}`);
}
const m = entry.data;

const basePath = lang === "en" ? "/en/modules" : "/modules";
const links = navUtama(lang === "en" ? "en" : "id");

// Five fixed groups per session, the whole term -- same constant every
// other group-hued surface in this app (Session Panels, the roster) uses.
const GROUPS = [1, 2, 3, 4, 5];

const tabs = [
  { id: "tab-ladder", label: t.live.tabLadder },
  { id: "tab-layers", label: t.live.tabLayers },
  { id: "tab-sandbox", label: t.live.tabSandbox },
];
---

<Base
  title={`${t.live.heading} · Modul ${m.modul} · IRIS IoT`}
  description={t.live.disclosureFor(m.modul)}
  cosmosScene="kerja"
  lang={lang}
>
  <main class="page-wide">
    <PageHeader
      back={{ href: `${basePath}/${m.modul}`, label: t.live.backToModule }}
      eyebrow={`${t.moduleWord} ${m.modul}`}
      title={`${m.judul} · ${t.live.heading}`}
      subtitle={t.live.disclosureFor(m.modul)}
    />

    <Tabs client:load id="live-tabs" tabs={tabs} />

    <div class="live-panels">
      <section id="tab-ladder" role="tabpanel" aria-labelledby="tab-ladder-tab" class="live-panel">
        <FlowDiagram client:load modul={m.modul} groups={GROUPS} />
      </section>

      <section
        id="tab-layers"
        role="tabpanel"
        aria-labelledby="tab-layers-tab"
        class="live-panel"
        hidden
      >
        <LayerXray client:load modul={m.modul} groups={GROUPS} layers={m.lapisan} />
      </section>

      <section
        id="tab-sandbox"
        role="tabpanel"
        aria-labelledby="tab-sandbox-tab"
        class="live-panel"
        hidden
      >
        <p class="live-panel__hint measure-prose">{t.live.fireHint}</p>
        <LiveSandbox client:load modul={m.modul} groups={GROUPS} layers={m.lapisan} />
      </section>
    </div>
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../scripts/per-halaman";
  import { applyLockScreen } from "../scripts/modul-akses";
  import { id as strId } from "../i18n/id";
  import { en as strEn } from "../i18n/en";
  function playEntrance() {
    window.Motion?.enter(".page-header > *");
  }
  sekaliPerHalaman("ModulLiveAnimasi", playEntrance);

  // P6.5: see ModuleDetailView.astro's own version of this check for why
  // the module number and language both come from the page itself rather
  // than a prop.
  function checkAkses() {
    const match = /\/modules\/(\d)\/live(?:\/|$)/.exec(location.pathname);
    if (!match) return;
    const t = document.documentElement.lang === "en" ? strEn : strId;
    const heading = document.querySelector(".page-header__title");
    void applyLockScreen(Number(match[1]), t.code.terkunci, "terkunci untuk praktikan", heading);
  }
  sekaliPerHalaman("ModulLiveAkses", checkAkses);
</script>

<style>
  .live-panels {
    padding-block: var(--space-6) var(--space-10);
  }

  .live-panel__hint {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
</style>
