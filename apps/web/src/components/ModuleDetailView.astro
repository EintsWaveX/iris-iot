---
/**
 * /modules/[n] (and /en/, /zh/): one module (Phase 9 Stage 7, mockups
 * m-browse and p-module). The head is static: back to all modules, the
 * module badge, title and topic, and bright buttons to the modules on
 * either side. Everything below it depends on who is looking, so it is one
 * island (module/ModuleSteps.tsx), mounted client:only so the first render
 * already knows the viewer, the width and the step.
 */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import ModuleSteps from "../components/module/ModuleSteps";
import { stringsFor } from "../i18n/zh";
import { getSketchSource } from "../lib/sketches";
import { parseBlanks } from "../lib/blanks";
import "../components/module/module.css";
import { bahasaKonten, type Lang } from "../lib/kelas";
import { modulLabel } from "../lib/labels";
import { href, MODUL_NAMA } from "../lib/app";

interface Props {
  lang: Lang;
  modul: number;
}

const { lang, modul } = Astro.props;
const t = stringsFor(lang);
const entry = await getEntry("modules", `${lang}/${modul}`);
if (!entry) {
  throw new Error(`no module content for ${lang}/${modul}`);
}
const m = entry.data;
const basePath = href(lang, "/modules");
const back = lang === "zh" ? "全部模块" : t.backToIndex;

const berkasSource = m.berkas.map((b) => ({
  ...b,
  slug: b.path.replace(/\.(ino|py)$/, ""),
  // Mandarin shows the English code with Mandarin comments and hints
  // (content/sketches/zh, 2026-10-09); downloads stay English.
  segments: parseBlanks(getSketchSource(lang === "zh" ? "zh" : bahasaKonten(lang), b.path)),
}));
const mcu = m.fakta[0] ?? "ESP32";
const arrowLeft =
  "M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z";
const caretLeft =
  "M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z";
const caretRight =
  "M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z";
---

<Base
  title={`${modulLabel(m.modul, lang)} · ${MODUL_NAMA[m.modul]} · IRIS IoT`}
  description={m.ringkasan[0]}
  card={`modul-${m.modul}`}
  cosmosScene="kerja"
  lang={lang}
>
  <main id="main" class="page-wide page-main modpage" style={`--mod-hue: var(--mod-${m.modul})`}>
    <header class="page-header modhead">
      <p class="page-header__context">
        <a class="back" href={basePath}>
          <svg viewBox="0 0 256 256" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d={arrowLeft}></path>
          </svg>
          {back}
        </a>
      </p>
      <div class="page-header__row">
        <div class="page-header__heading modhead__heading">
          <span class="pill pill--group pill--lg" style={`--pill-hue: var(--mod-${m.modul})`}>
            {modulLabel(m.modul, lang)}
          </span>
          <h1 class="page-header__title">{MODUL_NAMA[m.modul]}</h1>
          <p class="page-header__subtitle">{m.topik}</p>
        </div>
        <nav class="modhead__jump" aria-label={t.backToIndex}>
          {m.modul > 1 && (
            <a
              class="btn btn--inverse modjump"
              href={`${basePath}/${m.modul - 1}`}
              style={`--m: var(--mod-${m.modul - 1})`}
            >
              <svg
                viewBox="0 0 256 256"
                width="18"
                height="18"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={caretLeft}></path>
              </svg>
              {modulLabel(m.modul - 1, lang)}
            </a>
          )}
          {m.modul < 4 && (
            <a
              class="btn btn--inverse modjump"
              href={`${basePath}/${m.modul + 1}`}
              style={`--m: var(--mod-${m.modul + 1})`}
            >
              {modulLabel(m.modul + 1, lang)}
              <svg
                viewBox="0 0 256 256"
                width="18"
                height="18"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={caretRight}></path>
              </svg>
            </a>
          )}
        </nav>
      </div>
    </header>

    <ModuleSteps
      client:only="react"
      lang={lang}
      modul={m.modul}
      pdfUrl={`/handbook/${bahasaKonten(lang)}/modul-${m.modul}.pdf`}
      pdfName={t.modulDoc(m.modul)}
      ringkasan={m.ringkasan}
      permainan={m.permainan}
      fakta={m.fakta}
      toolchain={m.toolchain}
      perangkat={m.perangkat}
      persiapan={m.persiapan}
      pin={m.pin}
      mcu={mcu}
      skema={m.skema}
      layers={m.lapisan}
      code={{ modul: m.modul, bahasa: bahasaKonten(lang), berkas: berkasSource }}
    />
  </main>
</Base>
