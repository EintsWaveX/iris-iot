---
/**
 * /modules/[n] and /en/modules/[n]: one module, four steps (Brief, Persiapan,
 * Kode, Live) behind a progress-track stepper (ModuleCarousel.tsx), one step
 * visible at a time.
 *
 * Phase 8:
 * - Persiapan puts the interactive wiring diagram, the pin table and the real
 *   schematic (an assistant's upload when there is one) side by side, with a
 *   tickable checklist.
 * - Kode docks the same pin panel beside the code (CodeWorkspace.tsx).
 * - Live previews the layers and leads into the one live workspace.
 * - A locked module shows the app's own lock screen, and an assistant is no
 *   longer mistaken for a student there (modul-akses.ts read `peran`).
 */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import ModuleCarousel from "../components/ModuleCarousel";
import CodeWorkspace from "../components/module/CodeWorkspace";
import PinSchematic from "../components/module/PinSchematic";
import SetupChecklist from "../components/module/SetupChecklist";
import { id as strId } from "../i18n/id";
import { en as strEn } from "../i18n/en";
import { getSketchSource } from "../lib/sketches";
import { parseBlanks } from "../lib/blanks";
import "../components/module/module.css";

interface Props {
  lang: "id" | "en";
  modul: number;
}

const { lang, modul } = Astro.props;
const t = lang === "en" ? strEn : strId;
const en = lang === "en";
const entry = await getEntry("modules", `${lang}/${modul}`);
if (!entry) {
  throw new Error(`no module content for ${lang}/${modul}`);
}
const m = entry.data;
const basePath = en ? "/en/modules" : "/modules";

const steps = [
  { id: "brief", label: t.stepLabels.brief },
  { id: "setup", label: t.stepLabels.setup },
  { id: "code", label: t.stepLabels.code },
  { id: "live", label: t.stepLabels.live },
];

// Modules 1 and 3's sketches include a small, blank-free clock helper
// (iris_waktu.h / iris_waktu.py), served from public/sketches/; the Code
// step says where it goes.
const HELPER_FILE_BY_MODUL: Record<number, string> = { 1: "iris_waktu.h", 3: "iris_waktu.py" };
const helperFile = HELPER_FILE_BY_MODUL[m.modul];

const berkasSource = m.berkas.map((b) => ({
  ...b,
  slug: b.path.replace(/\.(ino|py)$/, ""),
  segments: parseBlanks(getSketchSource(m.bahasa, b.path)),
}));
const blankTotal = berkasSource.reduce(
  (a, b) => a + b.segments.filter((s) => s.kind === "blank").length,
  0,
);
const mcu = m.fakta[0] ?? "ESP32";
const L = {
  facts: en ? "At a glance" : "Sekilas",
  start: en ? "Start the setup" : "Mulai persiapan",
  blanks: en
    ? `${blankTotal} blanks across ${berkasSource.length} files`
    : `${blankTotal} bagian rumpang di ${berkasSource.length} berkas`,
  pins: en ? "Pins and schematic" : "Pin dan skema",
  toCode: en ? "Go to Code" : "Lanjut ke Kode",
  layers: en ? "What travels through each layer" : "Yang lewat di tiap lapisan",
  openLive: t.live.cta,
  prevMod: en ? "Previous module" : "Modul sebelumnya",
  nextMod: en ? "Next module" : "Modul berikutnya",
};
---

<Base
  title={`${t.moduleWord} ${m.modul} · ${m.judul} · IRIS IoT`}
  description={m.ringkasan[0]}
  cosmosScene="kerja"
  lang={lang}
>
  <main id="main" class="page-wide page-main modpage" style={`--mod-hue: var(--mod-${m.modul})`}>
    <PageHeader
      back={{ href: basePath, label: t.backToIndex }}
      eyebrow={`${t.moduleWord} ${m.modul}`}
      title={m.judul}
      subtitle={m.topik}
    >
      <nav
        slot="actions"
        class="modpage__adjacent"
        id="module-adjacent"
        aria-label={`${L.prevMod} / ${L.nextMod}`}
      >
        {m.modul > 1 && (
          <a
            class="modpage__adj"
            href={`${basePath}/${m.modul - 1}`}
            data-modul={m.modul - 1}
            style={`--mod-hue: var(--mod-${m.modul - 1})`}
          >
            <span aria-hidden="true">‹</span> M{m.modul - 1}
          </a>
        )}
        {m.modul < 4 && (
          <a
            class="modpage__adj"
            href={`${basePath}/${m.modul + 1}`}
            data-modul={m.modul + 1}
            style={`--mod-hue: var(--mod-${m.modul + 1})`}
          >
            M{m.modul + 1} <span aria-hidden="true">›</span>
          </a>
        )}
      </nav>
    </PageHeader>

    <div class="modpage__stepper">
      <ModuleCarousel
        client:load
        id="module-steps"
        steps={steps}
        prevLabel={t.nav.prev}
        nextLabel={t.nav.next}
      />
    </div>

    <section id="brief" role="tabpanel" aria-labelledby="brief-tab" class="modpage__panel">
      <div class="modpage__brief">
        <div class="stack stack--lg">
          <h2 class="modpage__h">{t.brief.heading}</h2>
          {m.ringkasan.map((p) => (
            <p class="modpage__lede">{p}</p>
          ))}
          {m.permainan && (
            <div class="panel sweep-edge">
              <h3 class="panel__title">{t.brief.gameHeading}</h3>
              {m.permainan.map((p) => (
                <p class="hint">{p}</p>
              ))}
            </div>
          )}
          <button type="button" class="btn btn--primary btn--lg modpage__go" data-go-step="setup">
            {L.start} <span aria-hidden="true">→</span>
          </button>
        </div>
        <aside class="panel modpage__facts">
          <span class="label-caps">{L.facts}</span>
          <div class="modpage__chips">
            {m.fakta.map((f) => (
              <span class="pill pill--mono">{f}</span>
            ))}
          </div>
          <ul class="modpage__kv">
            {m.toolchain.map((tc) => (
              <li>
                <span class="hint">{tc.label}</span>
                <b>{tc.alat}</b>
              </li>
            ))}
          </ul>
          <span class="hint">{L.blanks}</span>
        </aside>
      </div>
    </section>

    <section id="setup" role="tabpanel" aria-labelledby="setup-tab" class="modpage__panel" hidden>
      <div class="grid-2">
        <div class="panel">
          <h2 class="panel__title">{t.setup.toolchainHeading}</h2>
          <ul class="modpage__kv">
            {m.toolchain.map((tc) => (
              <li>
                <span class="hint">{tc.label}</span>
                <b>{tc.alat}</b>
              </li>
            ))}
          </ul>
        </div>
        <div class="panel">
          <h2 class="panel__title">{t.setup.hardwareHeading}</h2>
          <ul class="modpage__kv">
            {m.perangkat.map((p) => (
              <li>
                <b>{p.nama}</b>
                <span class="mono hint">{p.jumlah}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <h2 class="modpage__h">{L.pins}</h2>
      <PinSchematic
        client:visible
        lang={lang}
        modul={m.modul}
        pin={m.pin}
        mcu={mcu}
        skema={m.skema}
        variant="full"
      />

      <h2 class="modpage__h">{t.setup.checklistHeading}</h2>
      <SetupChecklist client:visible lang={lang} modul={m.modul} items={m.persiapan} />
    </section>

    <section id="code" role="tabpanel" aria-labelledby="code-tab" class="modpage__panel" hidden>
      <div class="modpage__codehead">
        <h2 class="modpage__h">{t.code.heading}</h2>
        <p class="hint modpage__note">{t.code.note}</p>
        {helperFile && (
          <p class="hint">
            {t.code.helperNote.split("{file}")[0]}
            <a href={`/sketches/${m.bahasa}/${helperFile}`} download>
              {helperFile}
            </a>
            {t.code.helperNote.split("{file}")[1]}
          </p>
        )}
      </div>
      <CodeWorkspace
        client:load
        lang={lang}
        pin={m.pin}
        mcu={mcu}
        skema={m.skema}
        code={{
          modul: m.modul,
          bahasa: m.bahasa,
          berkas: berkasSource,
          boardLabel: t.code.board,
          downloadLabel: t.code.download,
          downloadHint: t.code.downloadHint,
          masukHint: t.code.masuk,
          sesiBerubahHint: t.code.sesiBerubah,
          terkunciHint: t.code.terkunci,
        }}
      />
    </section>

    <section id="live" role="tabpanel" aria-labelledby="live-tab" class="modpage__panel" hidden>
      <div class="modpage__live">
        <div class="stack stack--lg">
          <h2 class="modpage__h">{t.live.heading}</h2>
          <p class="modpage__lede">{t.live.bodyFor(modul)}</p>
          <span class="pill pill--mono">{t.live.jalurLabel(m.ladder.jalur)}</span>
          <a class="btn btn--primary btn--lg modpage__go" href={`${basePath}/${m.modul}/live`}>
            {L.openLive} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="panel">
          <span class="label-caps">{L.layers}</span>
          <ol class="layerstack">
            {m.lapisan.map((l, i) => (
              <li style={`--i: ${i}`}>
                <b>{l.nama}</b>
                <span class="mono hint">{l.nilai}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { sekaliPerHalaman } from "../scripts/per-halaman";
  import { applyLockScreen, lockCards } from "../scripts/modul-akses";
  import { id as strId } from "../i18n/id";
  import { en as strEn } from "../i18n/en";

  function bindGo() {
    document.querySelectorAll<HTMLElement>("[data-go-step]").forEach((b) => {
      if (b.dataset.bound) return;
      b.dataset.bound = "1";
      b.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("iris:go-step", { detail: b.dataset.goStep }));
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  }

  function checkAkses() {
    const match = /\/modules\/(\d)(?:\/|$)/.exec(location.pathname);
    if (!match) return;
    const en = document.documentElement.lang === "en";
    const t = en ? strEn : strId;
    const heading = document.querySelector(".page-header__title");
    void applyLockScreen(
      Number(match[1]),
      t.code.terkunci,
      en ? "locked for students" : "terkunci untuk praktikan",
      heading,
    );
    const adjacent = document.getElementById("module-adjacent");
    if (adjacent) void lockCards(adjacent, en ? "Not open yet" : "Belum dibuka");
  }

  sekaliPerHalaman("ModulDetailGo", bindGo);
  sekaliPerHalaman("ModulDetailAkses", checkAkses);
</script>
