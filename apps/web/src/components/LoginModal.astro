---
/**
 * Login, as a modal over the landing page rather than a separate route.
 * Phase 5's own decision: two roles, one dialog, switched by tabs — the
 * same reasoning the old standalone /masuk page stated (a practitioner
 * and an assistant are both here to do the same thing, so a shared
 * surface keeps the two forms consistent by construction), now applied
 * to a Modal instead of a page.
 *
 * Opened three ways, all converging on the same window.Modal.open() call:
 *   - a `data-modal-open="login-modal"` trigger, e.g. Nav's "Masuk" action
 *     on index.astro (see that page's own script)
 *   - a plain link to `/?login=1` from anywhere else in the site, which
 *     `/masuk` and `/login` both now redirect to (see vercel.json) —
 *     index.astro's own script opens the modal when that query param is
 *     present
 *   - already-open on arrival is NOT auto-checked against a live session
 *     the way the old page did; only the `?login=1` arrival path checks
 *     `/api/auth/me` first, so a stale bookmark to the old routes skips
 *     straight to /dashboard instead of flashing the form.
 *
 * Errors surface inside the panel next to the field that caused them
 * rather than in a Toast, so the message sits closest to the thing to
 * fix — a change from the old page's toast-only errors, worth making
 * now that the form lives in a modal a Toast could arrive behind.
 */
import Modal from "./ui/Modal.astro";
import Field from "./ui/Field.astro";
import Button from "./ui/Button.astro";
import Tabs from "./ui/Tabs";
---

<Modal id="login-modal" title="Masuk">
  <Fragment slot="body">
    <p class="lede">Praktikan memakai NIM saja &middot; asisten memakai NIM dan kata sandi</p>

    <Tabs
      client:load
      id="login-peran-tabs"
      tabs={[
        { id: "login-panel-praktikan", label: "Praktikan" },
        { id: "login-panel-asisten", label: "Asisten" },
      ]}
    />

    <div id="login-panel-praktikan" role="tabpanel" class="panel">
      <form id="login-form-praktikan" novalidate>
        <Field
          id="login-praktikan-nim"
          label="NIM"
          name="nim"
          placeholder="2311102001"
          required
          autocomplete="username"
          hint="4–20 karakter, huruf dan angka."
        />
        <p class="field-error" id="login-praktikan-error" hidden></p>
        <Button kind="primary" type="submit" id="login-praktikan-submit">
          Masuk
        </Button>
      </form>
    </div>

    <div id="login-panel-asisten" role="tabpanel" class="panel" hidden>
      <form id="login-form-asisten" novalidate>
        <Field
          id="login-asisten-nim"
          label="NIM"
          name="nim"
          placeholder="101022300013"
          required
          autocomplete="username"
        />
        <Field
          id="login-asisten-password"
          label="Kata sandi"
          name="password"
          type="password"
          required
          autocomplete="current-password"
        />
        <p class="field-error" id="login-asisten-error" hidden></p>
        <Button kind="primary" type="submit" id="login-asisten-submit">
          Masuk
        </Button>
      </form>
    </div>
  </Fragment>
</Modal>

<Modal
  id="set-password-modal"
  title="Setel kata sandi asli"
  lede='Selama ini kata sandi asisten adalah NIM ditambah "1715", jadi siapa pun yang tahu NIM kalian bisa menghitungnya. Setel kata sandi asli sekali di sini, dan kata sandi lama berhenti berfungsi untuk akun ini.'
>
  <Fragment slot="body">
    <form id="set-password-form" novalidate>
      <Field
        id="set-password-baru"
        label="Kata sandi baru"
        name="password"
        type="password"
        required
        autocomplete="new-password"
        hint="Minimal 8 karakter."
      />
      <Field
        id="set-password-ulang"
        label="Ulangi kata sandi baru"
        name="passwordUlang"
        type="password"
        required
        autocomplete="new-password"
      />
      <p class="field-error" id="set-password-error" hidden></p>
    </form>
  </Fragment>
  <Fragment slot="actions">
    <Button kind="ghost" id="set-password-lewati" type="button">
      Lewati untuk sekarang
    </Button>
    <Button kind="primary" id="set-password-submit" type="submit" form="set-password-form">
      Setel kata sandi
    </Button>
  </Fragment>
</Modal>

<style>
  .lede {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .panel {
    padding-top: var(--space-6);
  }

  .field-error {
    color: var(--danger);
    font-size: var(--fs-small);
    margin-top: calc(var(--space-5) * -1 + var(--space-2));
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  type LoginFailure = { ok: false; kode: string };
  type LoginSuccess = Record<string, unknown> & { ok: true };

  const KODE_PESAN: Record<string, string> = {
    format_salah: "Formatnya belum benar. Periksa kembali isiannya.",
    terkunci: "Terlalu banyak percobaan gagal. Coba lagi dalam beberapa menit.",
    tidak_cocok: "NIM atau kata sandi tidak cocok.",
    tidak_ada_sesi: "Belum ada sesi yang berjalan. Tunggu asisten membukanya.",
    tidak_terdaftar: "NIM ini tidak terdaftar di sesi yang sedang berjalan.",
    terlalu_pendek: "Kata sandi minimal 8 karakter.",
    galat_server: "Server sedang bermasalah. Coba lagi sesaat lagi.",
  };

  function pesanUntuk(kode: string): string {
    return KODE_PESAN[kode] ?? "Masuk gagal. Coba lagi.";
  }

  function showError(errorId: string, message: string) {
    const el = document.getElementById(errorId);
    if (!el) return;
    el.textContent = message;
    el.hidden = false;
  }

  function clearError(errorId: string) {
    const el = document.getElementById(errorId);
    if (!el) return;
    el.hidden = true;
    el.textContent = "";
  }

  /** Posts a login (or login-adjacent) request and reports the outcome
   *  back to the caller instead of navigating itself, since the assistant
   *  path needs to branch on the response (perluAturSandi) before deciding
   *  where to go. */
  async function submitLogin(
    url: string,
    body: Record<string, string>,
    submitBtnId: string,
    errorId: string,
  ): Promise<LoginSuccess | null> {
    clearError(errorId);
    const btn = document.getElementById(submitBtnId) as HTMLButtonElement | null;
    btn?.setAttribute("data-loading", "yes");
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (data.ok) return data as LoginSuccess;
      showError(errorId, pesanUntuk((data as LoginFailure).kode));
      return null;
    } catch {
      showError(errorId, "Tidak dapat menghubungi server.");
      return null;
    } finally {
      btn?.setAttribute("data-loading", "no");
    }
  }

  async function submitSetPassword() {
    clearError("set-password-error");
    const password = (document.getElementById("set-password-baru") as HTMLInputElement).value;
    const ulang = (document.getElementById("set-password-ulang") as HTMLInputElement).value;

    if (password !== ulang) {
      showError("set-password-error", "Kedua kata sandi belum sama.");
      return;
    }

    const btn = document.getElementById("set-password-submit") as HTMLButtonElement | null;
    btn?.setAttribute("data-loading", "yes");
    try {
      const res = await fetch("/api/auth/set-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password }),
      });
      const data = await res.json();
      if (data.ok) {
        navigate("/dashboard");
        return;
      }
      showError("set-password-error", pesanUntuk((data as LoginFailure).kode));
    } catch {
      showError("set-password-error", "Tidak dapat menghubungi server.");
    } finally {
      btn?.setAttribute("data-loading", "no");
    }
  }

  function bindForms() {
    const praktikanForm = document.getElementById("login-form-praktikan");
    if (praktikanForm && !praktikanForm.dataset.bound) {
      praktikanForm.dataset.bound = "1";
      praktikanForm.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const nim = (document.getElementById("login-praktikan-nim") as HTMLInputElement).value;
        const result = await submitLogin(
          "/api/auth/student",
          { nim },
          "login-praktikan-submit",
          "login-praktikan-error",
        );
        if (result) navigate("/dashboard");
      });
    }

    const asistenForm = document.getElementById("login-form-asisten");
    if (asistenForm && !asistenForm.dataset.bound) {
      asistenForm.dataset.bound = "1";
      asistenForm.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const nim = (document.getElementById("login-asisten-nim") as HTMLInputElement).value;
        const password = (document.getElementById("login-asisten-password") as HTMLInputElement)
          .value;
        const result = await submitLogin(
          "/api/auth/assistant",
          { nim, password },
          "login-asisten-submit",
          "login-asisten-error",
        );
        if (!result) return;
        if (result.perluAturSandi) {
          window.Modal?.close("login-modal");
          window.Modal?.open("set-password-modal");
        } else {
          navigate("/dashboard");
        }
      });
    }

    const setPasswordForm = document.getElementById("set-password-form");
    if (setPasswordForm && !setPasswordForm.dataset.bound) {
      setPasswordForm.dataset.bound = "1";
      setPasswordForm.addEventListener("submit", (ev) => {
        ev.preventDefault();
        submitSetPassword();
      });
    }

    const skipBtn = document.getElementById("set-password-lewati");
    if (skipBtn && !skipBtn.dataset.bound) {
      skipBtn.dataset.bound = "1";
      skipBtn.addEventListener("click", () => navigate("/dashboard"));
    }
  }

  // The modal markup is static (not re-rendered), but this script is a
  // page-level <script> re-evaluated on every astro:page-load the same
  // way spotlight.ts/nav-scroll.ts are -- bindForms() guards against
  // double-binding with the dataset flag above rather than assuming it
  // only ever runs once.
  bindForms();
  document.addEventListener("astro:page-load", bindForms);
</script>
