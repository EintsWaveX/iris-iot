---
/**
 * /modules and /en/modules: the four module cards (home/ModuleCards.tsx)
 * with their live state, the student's progress, and for an assistant each
 * module's lock switch on the card.
 */
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import ModuleCards from "../components/home/ModuleCards";
import { moduleCards } from "../lib/module-cards";
import { id as strId } from "../i18n/id";
import { en as strEn } from "../i18n/en";
import type { Lang } from "../lib/kelas";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = lang !== "id" ? strEn : strId;
const modules = await moduleCards(lang);
---

<Base
  title={`${t.indexTitle} · IRIS IoT`}
  description={t.indexLede}
  cosmosScene="kerja"
  lang={lang}
>
  <main id="main" class="page-regular page-main">
    <PageHeader eyebrow="IRIS IoT" title={t.indexTitle} subtitle={t.indexLede} />
    <ModuleCards client:load lang={lang} modules={modules} />
  </main>
</Base>
