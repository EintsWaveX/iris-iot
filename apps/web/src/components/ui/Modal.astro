---
/**
 * A centred dialog on a backdrop. One instance lives in the page (usually
 * in Base.astro or a page layout) and is opened/closed by ID from anywhere
 * via the tiny global API src/scripts/modal.ts installs on window.
 *
 * Centring is grid placement (`place-items: center` on the backdrop), never
 * `transform: translate(-50%, -50%)`. apps/modul4/'s rebuild hit a real bug from
 * that second approach: a GSAP entrance tween animating `y` on the same
 * element overwrote the transform and left it stuck at `translate(-50%, 0%)`
 * under `fill: forwards`, which silently decentred any panel tall enough to
 * matter. Grid centring can't be clobbered by an unrelated transform tween,
 * so this file uses it from the start rather than discovering the bug again.
 *
 * Stage 4: closed state changed from the `hidden` attribute to `inert` +
 * `aria-hidden`, so opacity/scale can actually transition (a `[hidden]`
 * element is `display: none`, which cannot fade). `inert` blocks clicks
 * and keyboard focus on the whole closed subtree the instant it's set --
 * synchronously, before the fade-out even starts -- which is a more direct
 * fix than portfolio's `visibility: hidden` transition-delay trick for the
 * same problem (that trick exists there because it predates `inert`
 * support; ported the panel's scale/timing, not that specific workaround).
 *
 * Usage:
 *   <Modal id="confirm-clear" title="Clear the day plan?">
 *     <p slot="body">...</p>
 *     <Fragment slot="actions">
 *       <Button kind="ghost" data-modal-close>Cancel</Button>
 *       <Button kind="danger" id="confirm-clear-go">Clear it</Button>
 *     </Fragment>
 *   </Modal>
 *   <button data-modal-open="confirm-clear">Clear day plan</button>
 */
interface Props {
  id: string;
  title: string;
  lede?: string;
}

const { id, title, lede } = Astro.props;
---

<div class="modal" id={id} inert aria-hidden="true" data-modal>
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby={`${id}-title`}>
    <header class="modal__head">
      <h2 class="modal__title" id={`${id}-title`}>
        {title}
      </h2>
      {lede && <p class="modal__lede">{lede}</p>}
    </header>
    <div class="modal__body">
      <slot name="body" />
    </div>
    <footer class="modal__actions">
      <slot name="actions" />
    </footer>
  </div>
</div>

<style>
  .modal {
    display: grid;
    inset: 0;
    opacity: 0;
    padding: max(var(--space-5), env(safe-area-inset-top, 0px)) var(--space-5)
      max(var(--space-5), env(safe-area-inset-bottom, 0px));
    place-items: center;
    pointer-events: none;
    position: fixed;
    transition: opacity var(--dur-mid) var(--ease-out-expo);
    z-index: 100;
  }

  .modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal__backdrop {
    background: var(--scrim);
    inset: 0;
    position: absolute;
  }

  .modal__panel {
    background: var(--bg-elevated);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lift);
    max-height: 100%;
    max-width: min(32rem, 100%);
    overflow-y: auto;
    padding: var(--space-6);
    position: relative;
    transform: scale(0.96);
    transition: transform var(--dur-mid) var(--ease-out-expo);
    width: 100%;
  }

  .modal.is-open .modal__panel {
    transform: scale(1);
  }

  .modal__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .modal__title {
    font-size: var(--fs-display-sm);
  }

  .modal__lede {
    color: var(--text-muted);
  }

  .modal__actions {
    display: flex;
    gap: var(--space-3);
    justify-content: flex-end;
    margin-top: var(--space-6);
  }

  @media (max-width: 480px) {
    .modal__actions {
      flex-direction: column-reverse;
    }
  }
</style>

<script>
  import "../../scripts/modal.ts";
</script>
