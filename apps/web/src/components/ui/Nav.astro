---
/**
 * The top navigation, shared by every page (P7.3 rewrite). Two lessons
 * carried over verbatim from the apps/modul4/ mobile rebuild, because both
 * bugs are easy to reintroduce by accident in a new codebase:
 *
 * 1. `position: fixed` plus `backdrop-filter` on the SAME element makes
 *    that element a containing block for its own fixed-position
 *    descendants — a `position: fixed` child meant to escape it instead
 *    gets pinned inside it. This bar is one flat element with no fixed
 *    descendants, so the trap doesn't apply, but if a dropdown or a chip
 *    is ever added inside it, it must NOT be `position: fixed`.
 * 2. `position: fixed` creates a stacking context, so a z-index set on a
 *    descendant is scoped INSIDE that context and can still paint below an
 *    unrelated fixed sibling with a lower z-index than the descendant's
 *    number suggests. apps/modul4/'s bug: a bar at z-index 44 sat above a nav
 *    at z-index 40, even though the nav's own children were set to
 *    z-index 45 — those 45s were scoped inside the nav's context and never
 *    competed at the top level at all. Fixed here by giving both the top
 *    bar and the bottom tab bar the highest top-level z-indexes and never
 *    trying to out-rank either from inside a different stacking context.
 *
 * P7.3 shape: at 640px and up this renders as a full top bar (brand,
 * links, motion toggle, language switch when `lang` is passed, Masuk or
 * Keluar). Below 640px the top bar collapses to just the brand and an
 * "Akun" trigger (AkunSheet.tsx, a Radix bottom sheet holding the same
 * motion toggle / language switch / Masuk-Keluar), and the page's own
 * links move into a fixed bottom tab bar instead of the old horizontally
 * scrolling strip. Both variants are rendered unconditionally and split by
 * CSS `display: none` at the 640px breakpoint, not by JS, so there is no
 * layout flash while a media query result is read out of script.
 *
 * Masuk/Keluar used to be supplied per page via a `slot="side"` Fragment —
 * every page that gated on a session (dashboard/session/servers/reports)
 * carried an identical "Keluar" button, id, `.hidden-until-known` class and
 * logout script, and index.astro carried a near-identical Masuk/Keluar
 * pair (finding F11's kind of duplication). This component now owns that
 * state entirely: one `/api/auth/me` fetch decides both the role-scoped
 * link visibility (already existed here) and which of Masuk/Keluar to
 * show, and one click handler here owns the logout call. A page's own,
 * separate auth-gate check (redirecting away entirely for the wrong role)
 * is untouched — only the shared Masuk/Keluar UI moved.
 */
import type { NavLink } from "../../lib/nav-links";
import { id as strId } from "../../i18n/id";
import { en as strEn } from "../../i18n/en";
import Button from "./Button.astro";
import AkunSheet from "../AkunSheet";

interface Props {
  links: NavLink[];
  current?: string;
  /** Pass only on a page that has a real English/Indonesian mirror
   *  (today: the /modules family) -- omitting it hides the language
   *  switch entirely, exactly like before this component owned it. */
  lang?: "id" | "en";
  /** The current module number, for a language switch that lands on the
   *  same module rather than the bare modules index. */
  modul?: number;
}

const { links, current = Astro.url.pathname, lang, modul } = Astro.props;

const t = lang === "en" ? strEn : strId;
const langHref = lang ? t.langSwitchHref(modul) : undefined;
const langLabel = lang ? t.langSwitchLabel : undefined;
---

<header class="nav">
  <a class="nav__brand" href="/">
    <img
      class="nav__brand-logo"
      src="/brand/iris-logo-mark.png"
      alt="IRIS"
      width="397"
      height="180"
    />
  </a>

  <nav class="nav__links" aria-label="Utama">
    {links.map((l) => (
      <a
        class="nav__link"
        href={l.href}
        aria-current={current === l.href ? "page" : undefined}
        data-active={current === l.href ? "yes" : "no"}
        data-nav-peran={l.peran}
        hidden={l.peran === "asisten" ? true : undefined}
      >
        {l.label}
      </a>
    ))}
  </nav>

  <div class="nav__side">
    <button
      type="button"
      id="kurangi-efek-toggle"
      class="nav__reduce"
      data-motion-pref="auto"
      title="Efek gerak pada latar: Otomatis"
      aria-label="Efek gerak pada latar: Otomatis. Ketuk untuk mengubah."
    >
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3v3M12 18v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M3 12h3M18 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" />
      </svg>
      <span class="nav__reduce-label" id="kurangi-efek-label" aria-hidden="true">
        Otomatis
      </span>
    </button>

    {langHref && (
      <a class="nav__lang" href={langHref}>
        {langLabel}
      </a>
    )}

    <span class="nav__auth" data-auth-pending="yes">
      <Button kind="ghost" id="nav-btn-masuk">
        Masuk
      </Button>
      <Button kind="ghost" id="nav-btn-keluar" hidden>
        Keluar
      </Button>
    </span>
  </div>

  <AkunSheet client:load lang={lang} langHref={langHref} langLabel={langLabel} />
</header>

<nav class="bottombar" aria-label="Utama (mobile)">
  {links.map((l) => (
    <a
      class="bottombar__item"
      href={l.href}
      aria-current={current === l.href ? "page" : undefined}
      data-active={current === l.href ? "yes" : "no"}
      data-nav-peran={l.peran}
      hidden={l.peran === "asisten" ? true : undefined}
    >
      {l.label}
    </a>
  ))}
</nav>

<script>
  // Shows each role-scoped link (see nav-links.ts) only to the role that
  // can use it -- in both the top nav and the bottom tab bar, since P7.3
  // they share one link set -- and decides Masuk vs Keluar. The guard on
  // the nav element keeps the direct call and the astro:page-load that
  // also fires on a first load from fetching twice; a later navigation
  // brings a fresh .nav with no flag.
  function terapkanAuthNav() {
    const nav = document.querySelector<HTMLElement>(".nav");
    if (!nav || nav.dataset.authDiterapkan) return;
    nav.dataset.authDiterapkan = "1";

    const links = document.querySelectorAll<HTMLAnchorElement>(
      ".nav__link[data-nav-peran], .bottombar__item[data-nav-peran]",
    );
    const masuk = document.getElementById("nav-btn-masuk");
    const keluar = document.getElementById("nav-btn-keluar") as HTMLButtonElement | null;

    fetch("/api/auth/me")
      .then((r) => r.json())
      .then((me: { ok?: boolean; role?: string }) => {
        const peran = me.ok ? me.role : null;
        links.forEach((a) => {
          const untuk = a.dataset.navPeran;
          a.hidden = peran ? untuk !== peran : untuk === "asisten";
        });
        if (masuk) masuk.hidden = !!me.ok;
        if (keluar) keluar.hidden = !me.ok;
      })
      .catch(() => {
        // Left as rendered: signed-out defaults (Masuk shown, role-scoped
        // links hidden), the same fallback the old per-page scripts used.
      });

    if (keluar && !keluar.dataset.bound) {
      keluar.dataset.bound = "1";
      keluar.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        const tujuan = location.pathname === "/" ? "/" : "/?login=1";
        // astro:transitions/client's navigate() would need a per-page
        // import; a full navigation here is one extra round trip on an
        // action that already left the authenticated area, which is a
        // fair trade for keeping this single script page-agnostic.
        location.assign(tujuan);
      });
    }

    if (masuk && !masuk.dataset.bound) {
      masuk.dataset.bound = "1";
      masuk.addEventListener("click", () => window.LoginDialog?.open());
    }
  }

  terapkanAuthNav();
  document.addEventListener("astro:page-load", terapkanAuthNav);
</script>

<style>
  .nav {
    align-items: center;
    background: var(--panel-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    gap: var(--space-5);
    justify-content: space-between;
    min-height: var(--nav-size);
    padding: 0 var(--gutter);
    padding-top: env(safe-area-inset-top, 0px);
    position: sticky;
    top: 0;
    /* Highest top-level z-index on the page: a modal (100) and the toast host (200) sit above it deliberately. */
    z-index: 50;
  }

  /* The swept hairline: invisible while the page sits at the top (the bar
     has nothing to separate itself from yet), faded in by
     scripts/nav-scroll.ts once the page has actually scrolled. Painted with
     --sweep-ring (decorative, not text-bearing — a 1px line) rather than a
     flat colour so scrolling reads as one more cosmic-editorial gesture
     instead of a plain rule appearing. */
  .nav::after {
    background-image: var(--sweep-ring);
    background-size: 200% auto;
    bottom: 0;
    content: "";
    height: 1px;
    left: 0;
    opacity: 0;
    position: absolute;
    right: 0;
    transition: opacity var(--dur-mid) var(--ease-reveal);
  }

  .nav[data-scrolled="yes"]::after {
    animation: aurora-sweep 6s linear infinite;
    opacity: 1;
  }

  .nav__brand {
    align-items: center;
    color: var(--text);
    display: flex;
    min-height: max(var(--tap), 44px);
    min-width: 44px;
  }

  .nav__brand-logo {
    display: block;
    height: 28px;
    width: auto;
    filter: drop-shadow(0 0 8px rgba(64, 176, 255, 0.3));
  }

  .nav__links {
    align-items: center;
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    /* P6.3: a scrollbar here reads as a broken layout, not an affordance. */
    scrollbar-width: none;
  }

  .nav__links::-webkit-scrollbar {
    display: none;
  }

  .nav__link {
    align-items: center;
    color: var(--text-muted);
    display: flex;
    font-size: var(--fs-small);
    font-weight: 500;
    min-height: max(var(--tap), 44px);
    padding: 0 var(--space-3);
    white-space: nowrap;
  }

  /* Same trap as Button.astro's .btn[hidden]: .nav__link's own display:
     flex outranks the UA's [hidden] rule, so a role-hidden link would
     otherwise still render. */
  .nav__link[hidden] {
    display: none;
  }

  .nav__link[data-active="yes"] {
    box-shadow: inset 0 -2px 0 var(--accent);
    color: var(--text);
  }

  .nav__link:hover {
    color: var(--text);
  }

  .nav__side {
    align-items: center;
    display: flex;
    gap: var(--space-3);
  }

  /* A three-way cycling button (Otomatis / Penuh / Kurangi), not a binary
     toggle -- aria-pressed doesn't map cleanly to three states, so the
     visible label plus the dynamic `title` (both updated by
     cosmos-router.js) carry the state instead. */
  .nav__reduce {
    align-items: center;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    display: flex;
    gap: var(--space-2);
    height: max(var(--tap), 44px);
    justify-content: center;
    padding-inline: var(--space-3);
  }

  .nav__reduce:hover {
    color: var(--text);
  }

  /* Kurangi: this device/session is running at less than full motion,
     the one state worth calling out with colour -- Otomatis and Penuh
     both mean "whatever this device can afford, running", so neither
     needs to look like an active override the way Kurangi does. */
  .nav__reduce[data-motion-pref="kurangi"] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .nav__reduce .icon {
    height: 1.1em;
    width: 1.1em;
    flex-shrink: 0;
  }

  .nav__reduce-label {
    font-size: var(--fs-small);
    font-weight: 500;
    white-space: nowrap;
  }

  .nav__lang {
    color: var(--text-muted);
    font-size: var(--fs-small);
    font-weight: 500;
    padding: 0 var(--space-2);
    white-space: nowrap;
  }

  .nav__lang:hover {
    color: var(--text);
  }

  .nav__auth {
    align-items: center;
    display: flex;
  }

  /* Reserve Keluar's own space while auth state is still unknown, the
     same visibility-not-display trick .hidden-until-known used to do per
     page, so the bar doesn't jump once the fetch above resolves. Masuk
     defaults to shown (the common case) so there is nothing to reserve
     for it. */
  .nav__auth[data-auth-pending="yes"] #nav-btn-keluar:not([hidden]) {
    visibility: hidden;
  }

  /* ---- bottom tab bar (mobile, 639px and under) -------------------- */
  .bottombar {
    background: var(--panel-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--hairline);
    bottom: 0;
    display: none;
    left: 0;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    position: fixed;
    right: 0;
    z-index: 50;
  }

  .bottombar__item {
    align-items: center;
    color: var(--text-muted);
    display: flex;
    flex: 1;
    flex-direction: column;
    font-size: 0.68rem;
    gap: 2px;
    justify-content: center;
    min-height: max(var(--tap), 48px);
    padding: 6px 0;
  }

  .bottombar__item[hidden] {
    display: none;
  }

  .bottombar__item[data-active="yes"] {
    color: var(--accent);
  }

  @media (max-width: 639px) {
    .nav {
      gap: var(--space-3);
      padding-inline: var(--space-4);
    }

    .nav__links,
    .nav__reduce,
    .nav__lang,
    .nav__auth {
      display: none;
    }

    :global(body) {
      padding-bottom: calc(48px + env(safe-area-inset-bottom, 0px));
    }

    .bottombar {
      display: flex;
    }
  }
</style>
