---
/**
 * A small status/identity pill. `tone` picks a semantic colour;
 * `group` (1-10; Phase 9 runs up to ten groups a session, each with its
 * own hue) picks a group hue instead and overrides tone — carried over
 * from apps/modul4/'s rule that group identity and semantic state are never the
 * same visual channel (see tokens.css's HEAT section for why).
 *
 * Both channels land on the same `--badge-hue` custom property, so there is
 * exactly one rule for colour and background (ported from the portfolio's
 * `.badge`) and a new tone or a new group hue is a one-line addition rather
 * than a third copy of that rule. `--text-muted` is not itself a hue, but
 * `color-mix` against it produces the same washed-out neutral background
 * the old `data-tone="neutral"` rule hardcoded, so the one rule still holds
 * for that case too.
 */
interface Props {
  tone?: "neutral" | "accent" | "ok" | "warn" | "danger" | "gold";
  group?: 1 | 2 | 3 | 4 | 5;
  id?: string;
  class?: string;
  [attr: string]: unknown;
}

const TONE_HUES = {
  neutral: "var(--text-muted)",
  accent: "var(--accent-bright)",
  ok: "var(--ok)",
  warn: "var(--warn)",
  danger: "var(--danger)",
  gold: "var(--gold)",
} as const;

const { tone = "neutral", group, id, class: className, ...rest } = Astro.props;
const hue = group ? `var(--group-${group})` : TONE_HUES[tone];
---

<span id={id} class:list={["badge", className]} style={`--badge-hue: ${hue}`} {...rest}>
  <slot />
</span>

<style>
  /* Phase 9 kit: the same badge as Pill.tsx (upper case, bright edge). */
  .badge {
    align-items: center;
    background: color-mix(in srgb, var(--badge-hue) 18%, var(--surface-1));
    border: 1px solid color-mix(in srgb, var(--badge-hue) 55%, transparent);
    border-radius: var(--radius-pill);
    color: var(--badge-hue);
    display: inline-flex;
    font: 700 0.76rem/1 var(--font-body);
    gap: 6px;
    letter-spacing: 0.07em;
    min-height: 26px;
    padding: 2px 10px;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
