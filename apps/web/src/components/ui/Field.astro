---
/**
 * A labelled text input with its own error slot. Used for the NIM field on
 * the login screen and every form field after it — one place that owns
 * label placement, the 44px floor, and how an error is announced. The
 * `.field*` classes live in src/styles/field.css (global, imported by
 * Base.astro), not a scoped style here — P7.3's login dialog rewrite
 * needed the same classes from a React island, which Astro's per-component
 * scoping could never reach.
 */
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: "text" | "password" | "email" | "time" | "number" | "date";
  value?: string;
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  inputmode?: "text" | "numeric" | "tel";
  pattern?: string;
  hint?: string;
  error?: string;
}

const {
  id,
  label,
  name = id,
  type = "text",
  value,
  placeholder,
  autocomplete,
  required = false,
  inputmode,
  pattern,
  hint,
  error,
} = Astro.props;
---

<div class="field" data-invalid={error ? "yes" : "no"}>
  <label class="field__label" for={id}>
    {label}
  </label>
  <input
    class="field__input mono"
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    autocomplete={autocomplete}
    required={required}
    inputmode={inputmode}
    pattern={pattern}
    aria-invalid={error ? "true" : "false"}
    aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
  />
  {hint && !error && (
    <p class="field__hint" id={`${id}-hint`}>
      {hint}
    </p>
  )}
  {error && (
    <p class="field__error" id={`${id}-error`} role="alert">
      {error}
    </p>
  )}
</div>
