---
/**
 * A labelled text input with its own error slot. Used for the NIM field on
 * the login screen and every form field after it — one place that owns
 * label placement, the 44px floor, and how an error is announced.
 */
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: "text" | "password" | "email" | "time" | "number" | "date";
  value?: string;
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  inputmode?: "text" | "numeric" | "tel";
  pattern?: string;
  hint?: string;
  error?: string;
}

const {
  id,
  label,
  name = id,
  type = "text",
  value,
  placeholder,
  autocomplete,
  required = false,
  inputmode,
  pattern,
  hint,
  error,
} = Astro.props;
---

<div class="field" data-invalid={error ? "yes" : "no"}>
  <label class="field__label" for={id}>
    {label}
  </label>
  <input
    class="field__input mono"
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    autocomplete={autocomplete}
    required={required}
    inputmode={inputmode}
    pattern={pattern}
    aria-invalid={error ? "true" : "false"}
    aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
  />
  {hint && !error && (
    <p class="field__hint" id={`${id}-hint`}>
      {hint}
    </p>
  )}
  {error && (
    <p class="field__error" id={`${id}-error`} role="alert">
      {error}
    </p>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field__label {
    color: var(--text-muted);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .field__input {
    background: var(--bg-sunken);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    color: var(--text);
    font-size: var(--fs-body-lg);
    min-height: max(var(--tap), 44px);
    padding: 0 var(--space-4);
    transition:
      border-color var(--dur-fast) var(--ease-reveal),
      box-shadow var(--dur-fast) var(--ease-reveal);
    width: 100%;
  }

  .field__input:focus-visible {
    border-color: var(--accent);
    box-shadow: var(--glow-ring);
  }

  .field[data-invalid="yes"] .field__input {
    border-color: var(--danger);
  }

  .field__hint {
    color: var(--text-faint);
    font-size: var(--fs-small);
  }

  .field__error {
    color: var(--danger);
    font-size: var(--fs-small);
  }
</style>
