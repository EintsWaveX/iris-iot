---
/**
 * A labelled native <select>. Deliberately not a custom-styled dropdown:
 * a native select gets correct keyboard behaviour, screen-reader support,
 * and mobile picker UI for free, and nothing on this site needs the kind of
 * multi-column or searchable menu that would justify rebuilding it.
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  name?: string;
  options: Option[];
  value?: string;
  required?: boolean;
  hint?: string;
}

const { id, label, name = id, options, value, required = false, hint } = Astro.props;
---

<div class="select">
  <label class="select__label" for={id}>
    {label}
  </label>
  <select class="select__input" id={id} name={name} required={required}>
    {options.map((opt) => (
      <option value={opt.value} selected={opt.value === value}>
        {opt.label}
      </option>
    ))}
  </select>
  {hint && <p class="select__hint">{hint}</p>}
</div>

<style>
  .select {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .select__label {
    color: var(--text-muted);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .select__input {
    appearance: none;
    background:
      linear-gradient(45deg, transparent 50%, var(--text-faint) 50%),
      linear-gradient(135deg, var(--text-faint) 50%, transparent 50%);
    background-position:
      right var(--space-4) center,
      right calc(var(--space-4) + 6px) center;
    background-repeat: no-repeat;
    background-size:
      6px 6px,
      6px 6px;
    background-color: var(--bg-sunken);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    min-height: max(var(--tap), 44px);
    padding: 0 var(--space-8) 0 var(--space-4);
    transition:
      border-color var(--dur-fast) var(--ease-reveal),
      box-shadow var(--dur-fast) var(--ease-reveal);
    width: 100%;
  }

  .select__input:focus-visible {
    border-color: var(--accent);
    box-shadow: var(--glow-ring);
  }

  .select__hint {
    color: var(--text-faint);
    font-size: var(--fs-small);
  }
</style>
