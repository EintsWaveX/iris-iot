---
/**
 * The one button. Every clickable action on the site is either this, or a
 * plain <a>/<button> carrying the same `.btn` classes by hand (a React
 * island, or a vanilla script creating a control at runtime, neither of
 * which can render an Astro component) — never a one-off control with its
 * own inline styles. That is what "consistent styles for every button"
 * means in practice: one file (this component) plus one stylesheet
 * (src/styles/controls.css, imported globally by Base.astro since P6.3 --
 * a scoped Astro <style> block here could never have reached those other
 * call sites) own the visual contract, everything else just applies it.
 *
 * kind: "primary" is the accent-filled call to action (one per view, at
 * most); "secondary" is a real button surface (filled, less prominent than
 * primary) for a page's other real actions -- "Unduh CSV", "Akhiri sesi";
 * "ghost" is the quiet default; "danger" is for destructive actions
 * (matches the audit-log rule in the Phase 1 plan: destructive assistant
 * actions get a visually distinct control, not just a second click);
 * "quiet" is the older icon-only treatment, kept for existing call sites --
 * new icon-only buttons should use the `icon` prop below instead (P7.1),
 * which pairs the icon-only footprint with a real `kind` rather than
 * bundling shape and color into one kind the way "quiet" does. That
 * conflation is exactly what caused a real bug: a *labelled* button styled
 * with kind="quiet" rendered at 0 width on desktop, because quiet's shape
 * rules assume there is no label to make room for (see the Phase 7 redesign
 * notes, finding F4).
 * size: "md" (the default, 44px-plus tap target), "sm" for a denser control
 * inside a table row or a card's own action row, or "lg" for a page's one
 * standout action.
 * icon: true renders the button as a square icon-only control (no visible
 * label text -- pass an icon via the slot and a real accessible name via
 * aria-label) using whatever `kind` was given for its color treatment.
 */
interface Props {
  kind?: "primary" | "secondary" | "ghost" | "danger" | "quiet";
  size?: "md" | "sm" | "lg";
  icon?: boolean;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  loading?: boolean;
  href?: string;
  class?: string;
  id?: string;
  [attr: string]: unknown;
}

const {
  kind = "ghost",
  size = "md",
  icon = false,
  type = "button",
  disabled = false,
  loading = false,
  href,
  class: className,
  id,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  id={id}
  class:list={[
    "btn",
    `btn--${kind}`,
    size !== "md" && `btn--${size}`,
    icon && "btn--icon",
    className,
  ]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled || loading}
  aria-disabled={loading ? "true" : undefined}
  data-loading={loading ? "yes" : "no"}
  {...rest}
>
  <span class="btn__label">
    <slot />
  </span>
  <span class="btn__spinner" aria-hidden="true"></span>
</Tag>
