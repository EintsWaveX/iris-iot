---
/**
 * The one button. Every clickable action on the site is either this, or a
 * plain <a>/<button> carrying the same `.btn` classes by hand (a React
 * island, or a vanilla script creating a control at runtime, neither of
 * which can render an Astro component) — never a one-off control with its
 * own inline styles. That is what "consistent styles for every button"
 * means in practice: one file (this component) plus one stylesheet
 * (src/styles/controls.css, imported globally by Base.astro since P6.3 --
 * a scoped Astro <style> block here could never have reached those other
 * call sites) own the visual contract, everything else just applies it.
 *
 * kind: "primary" is the accent-filled call to action (one per view, at
 * most); "ghost" is the quiet default; "danger" is for destructive actions
 * (matches the audit-log rule in the Phase 1 plan: destructive assistant
 * actions get a visually distinct control, not just a second click);
 * "quiet" is a bordered icon-only control (no label, square footprint).
 * size: "md" (the default, 44px-plus tap target) or "sm" for a denser
 * control inside a table row or a card's own action row.
 */
interface Props {
  kind?: "primary" | "ghost" | "danger" | "quiet";
  size?: "md" | "sm";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  loading?: boolean;
  href?: string;
  class?: string;
  id?: string;
  [attr: string]: unknown;
}

const {
  kind = "ghost",
  size = "md",
  type = "button",
  disabled = false,
  loading = false,
  href,
  class: className,
  id,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  id={id}
  class:list={["btn", `btn--${kind}`, size === "sm" && "btn--sm", className]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled || loading}
  aria-disabled={loading ? "true" : undefined}
  data-loading={loading ? "yes" : "no"}
  {...rest}
>
  <span class="btn__label">
    <slot />
  </span>
  <span class="btn__spinner" aria-hidden="true"></span>
</Tag>
