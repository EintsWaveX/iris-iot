---
/**
 * A titled block on a hairline, not a floating glass box — the editorial
 * language carried over from apps/modul4/'s .section pattern, scoped to a single
 * card rather than a whole page section.
 *
 * `interactive` (P6.3/B11): before this prop existed, EVERY card lifted,
 * spotlit and rang on hover regardless of whether it did anything when
 * clicked -- a card of plain read-only stats got the exact same "this is
 * clickable" affordance as a card that navigates somewhere. Pass
 * `interactive` only on a card that is itself a link/button or wraps one
 * (e.g. the module index's `<a class="modules-index__card-link"><Card
 * .../></a>` pattern) so the motion means what it looks like it means.
 */
interface Props {
  title?: string;
  eyebrow?: string;
  interactive?: boolean;
  class?: string;
  id?: string;
  hidden?: boolean;
  [attr: string]: unknown;
}

const { title, eyebrow, interactive = false, class: className, id, hidden, ...rest } = Astro.props;
---

<article
  id={id}
  hidden={hidden}
  class:list={["card", interactive && "card--interactive", className]}
  {...rest}
>
  {(title || eyebrow) && (
    <header class="card__head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {title && <h3 class="card__title">{title}</h3>}
    </header>
  )}
  <div class="card__body">
    <slot />
  </div>
</article>

<style>
  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6);
    position: relative;
    transition:
      border-color var(--dur-mid) var(--ease-reveal),
      box-shadow var(--dur-mid) var(--ease-reveal),
      transform var(--dur-mid) var(--ease-out-expo);
  }

  /* A card that IS a link (or is wrapped in one -- see the docblock above)
     should never show the underline the base `a` rule paints (base.css:
     color/text-decoration-color on every anchor): the whole card is
     already the obvious click target, and an underline crawling under its
     title/body text reads as broken rather than as a link. */
  a > .card,
  .card a {
    text-decoration: none;
  }

  /* The swept gradient-border ring (P7.4): the same --sweep-ring/aurora-sweep
     treatment controls.css's .btn--ghost/.btn--secondary already use, so an
     interactive card reads as the same "clickable thing" as every other
     control on the site rather than carrying its own distinct hover
     language. Replaces the Stage 4 cursor-follow spotlight (retired along
     with scripts/spotlight.ts, its only consumer) -- a traveling sweep
     needs no mouse-position tracking, so this card and its focus state now
     look identical, which the spotlight version never could. Scoped to
     `.card--interactive` (P6.3/B11): a non-interactive card has nothing to
     invite a hover affordance for. */
  .card--interactive::after {
    background-image: var(--sweep-ring);
    background-size: 200% auto;
    border-radius: inherit;
    content: "";
    inset: 0;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    opacity: 0;
    padding: 1px;
    pointer-events: none;
    position: absolute;
    transition: opacity var(--dur-fast) var(--ease-reveal);
  }

  .card--interactive:hover,
  .card--interactive:focus-within {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--hairline));
    box-shadow: var(--shadow-lift);
    transform: var(--lift-card);
  }

  .card--interactive:hover::after,
  .card--interactive:focus-within::after {
    opacity: 1;
  }

  :root:not([data-motion-tier="0"]) .card--interactive:hover::after,
  :root:not([data-motion-tier="0"]) .card--interactive:focus-within::after {
    animation: aurora-sweep 2.2s linear infinite;
  }

  .card__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .card__title {
    font-size: var(--fs-display-sm);
  }

  /* A flex column, not just flex: 1 -- so a caller's own last child (a
     "Buka modul ->" footer row, say) can pin itself to the bottom of an
     equal-height card with `margin-top: auto` regardless of how much text
     the rest of the card holds (P6.3, the module index's own use). */
  .card__body {
    color: var(--text-muted);
    display: flex;
    flex: 1;
    flex-direction: column;
  }
</style>
