---
/**
 * The persistent sky behind every page (Phase 9): one canvas painted by
 * src/scripts/sky.ts, ported from the signed-off mockup. Marked
 * transition:persist so <ClientRouter /> keeps the same canvas and its
 * animation alive across every navigation instead of restarting it.
 *
 * What it paints follows html[data-theme] and html[data-detail] (see
 * public/theme-init.js): the night sky or the Daylight sky, at Low
 * Detail (still), Normal or High Detail. apps/games keeps kosmik's
 * cosmos.core.js sky; the web app no longer loads it.
 */
---

<div class="sky" aria-hidden="true" transition:persist transition:name="cosmos">
  <canvas id="iris-sky"></canvas>
</div>

<script>
  import "../scripts/cosmos-web.js";
  import "../scripts/cosmos-router.js";
  import "../scripts/sky.ts";
</script>

<style is:global>
  .sky {
    contain: layout paint style;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: fixed;
    z-index: -1;
  }

  .sky canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
