# /etc/iris-web/env on the PC Server (and %LOCALAPPDATA%\IRIS\iris-web.env on the laptop).
# Same values on both machines, so a session cookie signed on one is valid on the other.
# Never commit the real file. Copy the values from Vercel (Settings, Environment Variables,
# Production); the file here only names them. Mode root:iris-web 0640.

# Neon, the pooled connection string of iris-db-sin.
DATABASE_URL=

# Signs session cookies and tickets. Must equal Vercel's value, or everyone is signed out.
SESSION_SECRET=
# Encrypts stored credentials (SeeLabs accounts and the like).
DATA_KUNCI=
# Signs the Open Recruitment QR codes.
REC_QR_SECRET=

# The Konsol relay Worker: its secret, and its address with wss://.
KONSOL_RELAY_SECRET=
KONSOL_RELAY_URL=wss://konsol.irisiotlab.com

# The publish secret the bundle workflow uses at /api/agen.
BUNDEL_TERBIT=

# Vercel Blob (slides, schematics, photos) keeps working from any machine with its token,
# until those files move to R2.
BLOB_READ_WRITE_TOKEN=
