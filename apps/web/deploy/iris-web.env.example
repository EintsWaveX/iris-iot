# /etc/iris-web/env on the PC Server. Never commit the real file; the file here only names the values.
# Mode root:iris-web 0640. Set a secret with a silent prompt (`read -rs`), never by printing it.

# The Postgres on this PC (sudo -u postgres, role iris, database iris).
DATABASE_URL=postgresql://iris:...@127.0.0.1:5432/iris

# Signs session cookies and tickets. Changing it signs everyone out.
SESSION_SECRET=
# Encrypts stored credentials (SeeLabs accounts and the like). Keep a copy in a password manager.
DATA_KUNCI=
# Signs the Open Recruitment QR codes.
REC_QR_SECRET=

# The Konsol relay Worker: its secret (the same value is set on the Worker), and its address with wss://.
KONSOL_RELAY_SECRET=
KONSOL_RELAY_URL=wss://konsol.irisiotlab.com

# The publish secret the bundle workflow uses at /api/agen (also a GitHub secret).
BUNDEL_TERBIT=

# Live rooms and the lab clock run in this server (deploy/DEPLOY.md, section 8). Rollback switches:
#IRIS_RUANG_HUB=0
#IRIS_JAM_LAB=0
# Stops all posts to the Worker relay once nothing needs it (after a few quiet days).
#IRIS_RELAY_LAMA=0

# Measuring (deploy/DEPLOY.md, section 8). Without a token (16+ characters) /api/sehat?metrik=1 stays closed.
IRIS_METRIK_TOKEN=
# Log any answer slower than this many ms as "[server] slow ..." (default 2000).
#IRIS_LAMBAT_MS=200
# Size of the database pool (default 30).
#IRIS_DB_POOL=30
