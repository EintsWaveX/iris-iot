# /etc/iris-web/backup.env on the PC Server (root:root 0600). Never commit the real file.
# Cloudflare dashboard: R2, create a bucket (say iris-backups), then "Manage API tokens" and a
# token with Object Read & Write on that bucket only. The account id is in the R2 page's URL/sidebar.
# In the bucket's Settings, add an object lifecycle rule to delete objects older than 30 days.
R2_ACCOUNT_ID=
R2_BUCKET=iris-backups
R2_KEY_ID=
R2_SECRET=
