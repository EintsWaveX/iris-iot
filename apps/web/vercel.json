{
  "regions": ["sin1"],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "iris-praktikum-jurnal.vercel.app" }],
      "destination": "https://irisiotlab.com/$1",
      "permanent": true
    },
    {
      "source": "/masuk",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/privasi",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/ketentuan",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/dashboard/server",
      "destination": "/servers",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/sesi/kelompok",
      "destination": "/api/session/group"
    },
    {
      "source": "/api/sesi/akhiri",
      "destination": "/api/session/end"
    },
    {
      "source": "/api/sesi/:path*",
      "destination": "/api/session/:path*"
    },
    {
      "source": "/api/sesi",
      "destination": "/api/session"
    },
    {
      "source": "/api/auth/praktikan",
      "destination": "/api/auth/student"
    },
    {
      "source": "/api/auth/asisten",
      "destination": "/api/auth/assistant"
    },
    {
      "source": "/api/auth/keluar",
      "destination": "/api/auth/logout"
    },
    {
      "source": "/api/tindakan",
      "destination": "/api/action"
    },
    {
      "source": "/api/agen",
      "destination": "/api/agent"
    }
  ],
  "headers": [
    {
      "source": "/((?!handbook/).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-eIXWvAmxkr251LJZkjniEK5LcPF3NkapbJepohwYRIc='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://vercel.com https://*.public.blob.vercel-storage.com wss://konsol.irisiotlab.com https://konsol.irisiotlab.com wss://iris-konsol.iris-iot-relay.workers.dev https://iris-konsol.iris-iot-relay.workers.dev; frame-src 'self' https://*.public.blob.vercel-storage.com https://www.canva.com https://wokwi.com https://www.tinkercad.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/handbook/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/modul/[aksi].ts": {
      "includeFiles": "src/content/sketches/**"
    },
    "api/session/[aksi].ts": {
      "includeFiles": "{scripts/data_asisten.typ,src/content/sketches/**}"
    },
    "api/session/index.ts": {
      "includeFiles": "src/content/sketches/**"
    },
    "api/lms/[aksi].ts": {
      "maxDuration": 60
    },
    "api/tp/[aksi].ts": {
      "maxDuration": 60
    },
    "api/presentasi/[aksi].ts": {
      "includeFiles": "bundled/schematics/**"
    }
  }
}
