{
  "redirects": [
    {
      "source": "/masuk",
      "destination": "/?login=1",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/?login=1",
      "permanent": false
    },
    {
      "source": "/dashboard/server",
      "destination": "/servers",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/sesi/kelompok",
      "destination": "/api/session/group"
    },
    {
      "source": "/api/sesi/akhiri",
      "destination": "/api/session/end"
    },
    {
      "source": "/api/sesi/:path*",
      "destination": "/api/session/:path*"
    },
    {
      "source": "/api/sesi",
      "destination": "/api/session"
    },
    {
      "source": "/api/auth/praktikan",
      "destination": "/api/auth/student"
    },
    {
      "source": "/api/auth/asisten",
      "destination": "/api/auth/assistant"
    },
    {
      "source": "/api/auth/keluar",
      "destination": "/api/auth/logout"
    },
    {
      "source": "/api/tindakan",
      "destination": "/api/action"
    },
    {
      "source": "/api/agen",
      "destination": "/api/agent"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-ZjaA8J2lKFGPkjJnHbrairBo8ds7C5NVQ2EXr4Fto4A=' 'sha256-acavoPe7QKD45Tz0yYzNYhrWOKayI+GKxLOnyc2NEZA=' 'sha256-WVpdudcU+tNaFu7EAEwE0Z9z+QEo09vTa+kYVpKFoj0=' 'sha256-VGJU3vMOEQegeT1XNO0laChE+88A29XevxxhXV51GdI=' 'sha256-w+3QLEn087QBQ+azSIRfJnal/dfVaiqiU3RzhJy/UCc='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://vercel.com; frame-src 'self' https://*.public.blob.vercel-storage.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
